@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isStaff = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Librarian);
    var fullName = User.FindFirst("FullName")?.Value
        ?? User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
        ?? User.Identity?.Name;
    var title = ViewData["Title"] as string;
    // Trang chủ có dải tìm riêng; trang xác thực không cần ô tìm và nút đăng nhập trên header.
    var isHome = ViewData["IsHome"] as bool? == true;
    var isAuthPage = ViewData["IsAuthPage"] as bool? == true;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Thư viện Đại học Giao thông Vận tải: tra cứu giáo trình, tài liệu chuyên ngành, tình trạng sách và thông tin phục vụ bạn đọc." />
    <title>@(string.IsNullOrEmpty(title) ? "Thư viện UTC" : $"{title} – Thư viện UTC")</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png" />
    <link rel="preload" href="~/fonts/be-vietnam-pro-vietnamese-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/areas/reader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/areas/library.css" asp-append-version="true" />
    @if (isHome)
    {
        <link rel="stylesheet" href="~/css/areas/portal-home.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="reader-area d-flex flex-column @(isHome ? "portal-home" : "")">
    <a class="visually-hidden-focusable" href="#main">Bỏ qua đến nội dung chính</a>

    @if (isHome)
    {
        <partial name="_PortalHeader" />
    }
    else
    {
    <header class="site-header">
        <div class="wrap site-header__inner">
            <a class="brand" href="/">
                <img class="brand__logo" src="~/images/utc-logo-128.webp" width="40" height="40" alt="Logo UTC" />
                <span class="brand__text">
                    <span class="brand__name">Thư viện UTC</span>
                    <span class="brand__org">Trường Đại học Giao thông Vận tải</span>
                </span>
            </a>

            @if (isHome)
            {
                <nav class="desktop-library-nav" aria-label="Điều hướng chính">
                    <a href="/" aria-current="page">Trang chủ</a>
                    <a href="@Screens.GetPath(ScreenId.BookCatalog)">Tra cứu sách</a>
                    <a href="/#library-services">Dịch vụ thư viện</a>
                    <a href="/#about-library">Giới thiệu</a>
                </nav>
            }

            @if (!isHome && !isAuthPage)
            {
                <div class="site-header__search">
                    <vc:search-bar />
                </div>
            }

            <div class="site-header__account">
                @if (isHome)
                {
                    <button class="btn btn-quiet library-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mobileLibraryNav" aria-expanded="false" aria-controls="mobileLibraryNav"><i class="bi bi-list" aria-hidden="true"></i><span class="visually-hidden">Mở điều hướng</span></button>
                }
                @if (isAuthenticated)
                {
                    <div class="dropdown">
                        <button class="account-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            <span class="account-toggle__name">@fullName</span>
                            <span class="visually-hidden">Mở menu tài khoản</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (isStaff)
                            {
                                <li><a class="dropdown-item" href="@Screens.GetPath(ScreenId.ManageBooks)">Vào quầy thủ thư</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" href="@Screens.GetPath(ScreenId.ReaderProfile)">Sách đang mượn</a></li>
                                <li><a class="dropdown-item" href="@Screens.GetPath(ScreenId.ReaderBorrowHistory)">Lịch sử mượn</a></li>
                                <li><a class="dropdown-item" href="@Screens.GetPath(ScreenId.ReaderFines)">Tiền phạt</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else if (!isAuthPage)
                {
                    <a class="site-header__register" href="@Screens.GetPath(ScreenId.Register)">Đăng ký thẻ</a>
                    <a class="btn btn-quiet" href="@Screens.GetPath(ScreenId.Login)">Đăng nhập</a>
                }
            </div>
        </div>
        @if (isHome)
        {
            <nav class="collapse mobile-library-nav wrap" id="mobileLibraryNav" aria-label="Điều hướng trên điện thoại"><a href="/" aria-current="page">Trang chủ</a><a href="@Screens.GetPath(ScreenId.BookCatalog)">Tra cứu sách</a><a href="/#library-services">Dịch vụ thư viện</a><a href="/#about-library">Giới thiệu</a><a href="@Screens.GetPath(ScreenId.Register)">Đăng ký thẻ thư viện</a></nav>
        }
    </header>
    }

    <main id="main" class="site-main flex-grow-1 @(isHome ? "site-main--flush-top" : "") @(isAuthPage ? "site-main--auth" : "")">
        @if (isHome)
        {
            @RenderBody()
        }
        else
        {
            <div class="wrap">
                @RenderBody()
            </div>
        }
    </main>

    @if (isHome)
    {
        <partial name="_PortalFooter" />
    }
    else
    {
    <footer class="site-footer">
        <div class="wrap library-footer" id="about-library">
            <div><a class="brand" href="/"><img class="brand__logo" src="~/images/utc-logo-128.webp" width="40" height="40" alt="Logo UTC" /><span class="brand__text"><span class="brand__name">Thư viện UTC</span><span class="brand__org">Trường Đại học Giao thông Vận tải</span></span></a><p>Đồng hành cùng học tập, giảng dạy và nghiên cứu.</p></div>
            <nav aria-label="Liên kết cuối trang"><a href="@Screens.GetPath(ScreenId.BookCatalog)">Tra cứu sách</a><a href="/#library-services">Thông tin thư viện</a>
            @if (!isAuthenticated)
            {
                <a href="@Screens.GetPath(ScreenId.StaffLogin)">Đăng nhập cán bộ</a>
            }
            </nav>
        </div>
        <div class="wrap library-footer__bottom"><span>© @DateTime.Now.Year Thư viện Đại học Giao thông Vận tải</span><span>Học tập hôm nay. Kiến tạo ngày mai.</span></div>
    </footer>
    }

    <partial name="_Toast" />
    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
