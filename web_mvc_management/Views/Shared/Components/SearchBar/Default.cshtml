@model (string Keyword, string Scope, bool Hero, bool Autofocus)
@{
    var id = Model.Hero ? "searchHero" : "searchHeader";
}
@* Cùng form GET và combobox gợi ý cho trang chủ lẫn header. *@
<form class="searchbar @(Model.Hero ? "searchbar--hero" : "")" role="search" method="get" action="@Screens.GetPath(ScreenId.BookCatalog)"
      data-suggest-url="@Url.Action("Suggest", "Books")">
    <input type="hidden" name="scope" value="@Model.Scope" data-search-scope-input />
    <label for="@id" class="visually-hidden">Tìm sách trong thư viện</label>
    <div class="searchbar__field">
        @if (Model.Hero){<i class="bi bi-search searchbar__icon" aria-hidden="true"></i>}
        <input id="@id" name="keyword" type="search" value="@Model.Keyword" autocomplete="off"
               class="form-control searchbar__input @(Model.Hero ? "form-control-lg" : "")"
               placeholder="Tên sách, tác giả hoặc ISBN"
               role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="@(id)List"
               @(Model.Autofocus ? "autofocus" : "") data-search-input />
        <kbd class="searchbar__key" aria-hidden="true">/</kbd>
        @if (Model.Hero)
        {
            <button type="submit" class="btn btn-primary btn-lg searchbar__submit"><i class="bi bi-search" aria-hidden="true"></i><span>Tìm kiếm</span></button>
        }
        else
        {
            <button type="submit" class="btn btn-quiet searchbar__submit">
                <i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Tìm</span>
            </button>
        }
    </div>
    <ul class="search-suggest" id="@(id)List" role="listbox" aria-label="Gợi ý sách" hidden></ul>
    <p class="visually-hidden" role="status" aria-live="polite" data-search-status></p>
</form>
