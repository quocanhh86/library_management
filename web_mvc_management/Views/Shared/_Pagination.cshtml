@model web_mvc_management.Common.IPagedResult
@{
    if (Model == null || Model.TotalCount == 0) return;

    string BuildPageUrl(int pageNo, int? pageSize = null)
    {
        var routeValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary();
        foreach (var q in Context.Request.Query)
        {
            var keyLower = q.Key.ToLowerInvariant();
            if (keyLower != "pageno" && keyLower != "pageindex" && keyLower != "page" && keyLower != "pagesize" && keyLower != "pageitemsize")
            {
                routeValues[q.Key] = q.Value.ToString();
            }
        }
        routeValues["pageNo"] = pageNo;
        routeValues["pageItemSize"] = pageSize ?? Model.PageItemSize;
        return Url.Action(null, null, routeValues) ?? $"?pageNo={pageNo}&pageItemSize={pageSize ?? Model.PageItemSize}";
    }

    var pageNumbers = Model.GetPageNumbers(5);
    var showSizePicker = ViewData["ShowPageSize"] as bool? ?? true;
}

<div class="pager">
    <div class="pager__info num">
        @Model.StartItemIndex–@Model.EndItemIndex trong @Model.TotalCount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination pagination-sm">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="page-link" href="@BuildPageUrl(Model.PageNo - 1)" rel="prev">‹ Trước</a>
                    }
                    else
                    {
                        <span class="page-link">‹ Trước</span>
                    }
                </li>

                @if (pageNumbers.FirstOrDefault() > 1)
                {
                    <li class="page-item"><a class="page-link" href="@BuildPageUrl(1)">1</a></li>
                    if (pageNumbers.FirstOrDefault() > 2)
                    {
                        <li class="page-item disabled d-none d-sm-block"><span class="page-link">…</span></li>
                    }
                }

                @foreach (var p in pageNumbers)
                {
                    if (p == Model.PageNo)
                    {
                        <li class="page-item active" aria-current="page"><span class="page-link">@p</span></li>
                    }
                    else
                    {
                        <li class="page-item d-none d-sm-block"><a class="page-link" href="@BuildPageUrl(p)">@p</a></li>
                    }
                }

                @if (pageNumbers.LastOrDefault() < Model.TotalPages)
                {
                    if (pageNumbers.LastOrDefault() < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled d-none d-sm-block"><span class="page-link">…</span></li>
                    }
                    <li class="page-item"><a class="page-link" href="@BuildPageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    @if (Model.HasNextPage)
                    {
                        <a class="page-link" href="@BuildPageUrl(Model.PageNo + 1)" rel="next">Sau ›</a>
                    }
                    else
                    {
                        <span class="page-link">Sau ›</span>
                    }
                </li>
            </ul>
        </nav>
    }

    @if (showSizePicker)
    {
        <label class="pager__size">
            <span>Mỗi trang</span>
            <select class="form-select" data-pager-size>
                @foreach (var size in AppConstants.AllowedPageSizes)
                {
                    <option value="@BuildPageUrl(1, size)" selected="@(Model.PageItemSize == size)">@size</option>
                }
            </select>
        </label>
    }
</div>
