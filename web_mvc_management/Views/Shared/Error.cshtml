@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="auth-wrap py-4">
    <h1 class="page-title">Có lỗi khi xử lý yêu cầu</h1>
    <p class="mb-4">Thử tải lại trang. Nếu vẫn lỗi, báo thủ thư hoặc quản trị viên kèm mã yêu cầu bên dưới.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted-ink fs-xs mb-4">Mã yêu cầu: <span class="num">@Model.RequestId</span></p>
    }
    <a class="btn btn-primary" href="/">Về trang chủ</a>
</div>
