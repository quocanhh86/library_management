@model web_mvc_management.Models.ViewModels.Auth.ReaderLoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["IsAuthPage"] = true;
}

<div class="auth-wrap">
    <div class="auth-panel">
        <partial name="~/Views/Account/_AuthHead.cshtml" model='("Đăng nhập", 1, (string?)"reader")' />

        <form asp-action="Login" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="UsernameOrEmail" class="form-label"></label>
                <input asp-for="UsernameOrEmail" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="UsernameOrEmail"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <button type="button" class="btn btn-link password-field__toggle" data-password-toggle aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">Hiện mật khẩu</span>
                    </button>
                </div>
                <span asp-validation-for="Password"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <div asp-validation-summary="ModelOnly" class="inline-error mb-3" role="alert"></div>

            <button type="submit" class="btn btn-primary w-100">Tiếp tục</button>
            <p class="auth-hint">Mã xác thực sẽ gửi tới email của bạn.</p>
        </form>

        <p class="auth-alt">Chưa có thẻ? <a asp-action="Register">Đăng ký thẻ thư viện</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
