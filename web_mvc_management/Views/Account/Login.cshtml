@model web_mvc_management.Models.ViewModels.Auth.ReaderLoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Độc Giả";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle p-3 mb-2 shadow-sm">
                    <i class="bi bi-book-half fs-2"></i>
                </div>
                <h4 class="fw-bold mb-1">Thư Viện UTC</h4>
                <p class="text-white-50 small mb-0">Cổng đăng nhập dành cho Độc giả (Sinh viên / Giảng viên)</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="UsernameOrEmail" class="form-label fw-semibold text-secondary small">TÊN ĐĂNG NHẬP HOẶC EMAIL</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="UsernameOrEmail" class="form-control border-start-0 ps-0" placeholder="VD: student01 hoặc email..." required autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary small">MẬT KHẨU</label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" id="passwordInput" class="form-control border-start-0 border-end-0 ps-0" placeholder="Nhập mật khẩu..." required autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary border-start-0" id="togglePasswordBtn">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label text-muted small">Ghi nhớ đăng nhập</label>
                        </div>
                        <span class="badge bg-light text-primary border"><i class="bi bi-shield-check me-1"></i>Bảo mật 2FA OTP</span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Đăng Nhập &rarr;
                        </button>
                    </div>

                    <div class="text-center pt-3 border-top">
                        <p class="text-muted small mb-2">Chưa có thẻ thư viện? <a asp-action="Register" class="text-primary fw-semibold text-decoration-none">Đăng ký mở thẻ ngay</a></p>
                        <a asp-action="StaffLogin" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1 text-decoration-none mt-1">
                            <i class="bi bi-person-badge me-1"></i>Dành cho Cán bộ / Thủ thư (Gmail OTP) &rarr;
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Minimal JavaScript: Chỉ dùng bật/tắt hiển thị mật khẩu
        $('#togglePasswordBtn').on('click', function () {
            const input = $('#passwordInput');
            const icon = $('#togglePasswordIcon');
            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
                icon.removeClass('bi-eye').addClass('bi-eye-slash');
            } else {
                input.attr('type', 'password');
                icon.removeClass('bi-eye-slash').addClass('bi-eye');
            }
        });
    </script>
}
