@model web_mvc_management.Models.ViewModels.Auth.VerifyOtpViewModel
@using web_mvc_management.Services
@{
    ViewData["Title"] = "Nhập mã xác thực";
    ViewData["IsAuthPage"] = true;
    var isRegister = Model.Purpose == AuthService.PurposeRegister;
    var backAction = Model.Purpose switch
    {
        AuthService.PurposeRegister => "Register",
        AuthService.PurposeStaffLogin => "StaffLogin",
        _ => "Login"
    };
    var hasCodeError = ViewData.ModelState[nameof(Model.OtpCode)]?.Errors.Count > 0;
    var validitySeconds = (int)OtpService.DefaultValidity.TotalSeconds;
}

<div class="auth-wrap">
    <div class="auth-panel">
        <partial name="~/Views/Account/_AuthHead.cshtml" model='("Nhập mã xác thực", 2, (string?)null)' />

        @* data-otp-*: thời hạn mã và thời gian chờ gửi lại, lấy từ OtpService / EmailService *@
        <div data-otp-timer data-validity="@validitySeconds" data-cooldown="@EmailService.CooldownSeconds"
             data-key="otp:@Model.Purpose:@Model.Email">
            <p class="mb-4">
                Mã gồm 6 số, đã gửi tới <strong>@(Model.MaskedEmail ?? Model.Email)</strong>.
                <span data-otp-expiry-text>Mã hết hạn sau <span class="num" data-otp-expiry>@(validitySeconds / 60):00</span>.</span>
            </p>

            <form asp-action="VerifyOtp" method="post" id="otpForm" novalidate>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Purpose" />
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="OtpCode" data-otp-value />

                <span id="otpLabel" class="form-label d-block">Mã xác thực</span>
                <div class="otp @(hasCodeError ? "otp--invalid" : "")" role="group" aria-labelledby="otpLabel" data-otp-boxes>
                    @for (var i = 0; i < 6; i++)
                    {
                        <input class="form-control otp__box" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                               aria-label="Số thứ @(i + 1)" autocomplete="@(i == 0 ? "one-time-code" : "off")" @(i == 0 ? "autofocus" : "") />
                    }
                </div>
                <div class="inline-error mb-3 @(hasCodeError ? "" : "d-none")" role="alert" data-otp-error>
                    <span asp-validation-for="OtpCode"></span>
                </div>
                <div asp-validation-summary="ModelOnly" class="inline-error mb-3" role="alert"></div>

                <button type="submit" class="btn btn-primary w-100 mt-2">Xác nhận mã</button>
            </form>

            <form asp-action="ResendOtp" method="post" class="auth-alt" data-otp-resend-form>
                <input type="hidden" name="purpose" value="@Model.Purpose" />
                Không nhận được mã?
                <button type="submit" class="btn btn-link p-0 align-baseline otp-resend" data-otp-resend>
                    Gửi lại mã <span class="num" data-otp-cooldown></span>
                </button>
                <br />
                <a asp-action="@backAction">@(isRegister ? "Sửa thông tin đăng ký" : "Đổi tài khoản")</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/otp.js" asp-append-version="true"></script>
}
