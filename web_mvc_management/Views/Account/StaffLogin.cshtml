@model web_mvc_management.Models.ViewModels.Auth.StaffLoginViewModel
@{
    ViewData["Title"] = "Đăng nhập cán bộ";
    ViewData["IsAuthPage"] = true;
}

<div class="auth-wrap">
    <div class="auth-panel">
        <partial name="~/Views/Account/_AuthHead.cshtml" model='("Đăng nhập", 1, (string?)"staff")' />

        <form asp-action="StaffLogin" method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ten@utc.edu.vn" autocomplete="email" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <div asp-validation-summary="ModelOnly" class="inline-error mb-3" role="alert"></div>

            <button type="submit" class="btn btn-primary w-100">Gửi mã xác thực</button>
            <p class="auth-hint">Mã xác thực sẽ gửi tới hộp thư này.</p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
