@model web_mvc_management.Models.ViewModels.Auth.StaffLoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Cán Bộ & Quản Trị Viên";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white text-center py-4 position-relative" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%) !important;">
                <div class="d-inline-flex align-items-center justify-content-center bg-white text-dark rounded-circle p-3 mb-2 shadow-sm">
                    <i class="bi bi-shield-lock-fill fs-2 text-primary"></i>
                </div>
                <h4 class="fw-bold mb-1">Cổng Nghiệp Vụ Thư Viện</h4>
                <p class="text-white-50 small mb-0">Dành cho Cán bộ Quản trị (Admin) &amp; Thủ thư (Librarian)</p>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle position-absolute top-0 end-0 m-3 px-2 py-1 small">
                    <i class="bi bi-patch-check-fill me-1"></i>Passwordless OTP
                </span>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-action="StaffLogin" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>

                    <div class="alert alert-light border small mb-4 p-3 rounded-3 text-secondary">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-envelope-shield text-primary fs-5 me-2 mt-1"></i>
                            <div>
                                <strong>Cơ chế bảo mật Passwordless Gmail OTP:</strong>
                                <div class="small mt-1">Cán bộ nhập địa chỉ Gmail hoặc Email công vụ được phân quyền. Sau khi gửi, hệ thống sẽ phát sinh mã OTP gửi về hòm thư để xác minh danh tính.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary small">GMAIL HOẶC EMAIL CÔNG VỤ</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-google"></i></span>
                            <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="canbo@gmail.com hoặc admin@utc.edu.vn" required autocomplete="email" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-dark py-2 fw-semibold rounded-3 shadow-sm" style="background-color: #1e293b; border-color: #1e293b;">
                            <i class="bi bi-send-check me-1"></i>
                            Gửi Mã Xác Thực OTP &rarr;
                        </button>
                    </div>

                    <div class="text-center pt-3 border-top">
                        <p class="text-muted small mb-0">
                            Bạn là bạn đọc / sinh viên? 
                            <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">
                                <i class="bi bi-arrow-left-circle me-1"></i>Về cổng Đăng nhập Độc giả
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
