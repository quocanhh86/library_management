@{
    ViewData["Title"] = "Không có quyền mở trang";
}

<div class="auth-wrap py-4">
    <h1 class="page-title">Bạn không có quyền mở trang này</h1>
    <p class="mb-4">Tài khoản đang đăng nhập không được cấp quyền cho trang này. Nếu bạn là thủ thư, hãy đăng nhập bằng tài khoản cán bộ.</p>
    <a class="btn btn-primary" href="/">Về trang chủ</a>
    <p class="auth-alt"><a href="@Screens.GetPath(ScreenId.StaffLogin)">Đăng nhập bằng tài khoản cán bộ</a></p>
</div>
