@{
    ViewData["Title"] = "Từ Chối Truy Cập - 403 Forbidden";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
            <div class="mb-4">
                <span class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle p-4 shadow-sm">
                    <i class="bi bi-shield-slash-fill" style="font-size: 3.5rem;"></i>
                </span>
            </div>

            <h2 class="fw-bold text-dark mb-2">403 - Quyền Truy Cập Bị Từ Chối</h2>
            <p class="text-secondary mb-4">
                Tài khoản của bạn hiện không có đủ đặc quyền hoặc vai trò bảo mật hợp lệ để truy cập vào khu vực này.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                    <i class="bi bi-house-door me-1"></i>Trang Chủ
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 py-2 rounded-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập Khác
                </a>
            </div>
        </div>
    </div>
</div>
