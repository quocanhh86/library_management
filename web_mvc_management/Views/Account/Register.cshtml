@model web_mvc_management.Models.ViewModels.Auth.ReaderRegisterViewModel
@{
    ViewData["Title"] = "Đăng ký thẻ thư viện";
    ViewData["IsAuthPage"] = true;
    var readerTypes = ViewBag.ReaderTypes as IEnumerable<web_mvc_management.Entity.ReaderType> ?? [];
}

<div class="auth-wrap auth-wrap--wide">
    <div class="auth-panel">
        <partial name="~/Views/Account/_AuthHead.cshtml" model='("Đăng ký thẻ thư viện", 1, (string?)null)' />

        <form asp-action="Register" method="post" novalidate>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" autofocus />
                    <span asp-validation-for="FullName"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Username"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="email" aria-describedby="emailHint" />
                    <div id="emailHint" class="form-text">Mã xác thực sẽ gửi tới email này.</div>
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" placeholder="0912345678" />
                    <span asp-validation-for="Phone"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReaderTypeId" class="form-label"></label>
                    <select asp-for="ReaderTypeId" class="form-select">
                        <option value="">Chọn loại độc giả</option>
                        @foreach (var type in readerTypes)
                        {
                            <option value="@type.Id">@type.Name: @type.MaxBorrowBooks cuốn, @type.LoanDays ngày</option>
                        }
                    </select>
                    <span asp-validation-for="ReaderTypeId"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MemberCode" class="form-label"></label>
                    <input asp-for="MemberCode" class="form-control num" inputmode="numeric" />
                    <span asp-validation-for="MemberCode"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label">Ngày sinh (không bắt buộc)</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" autocomplete="bday" />
                    <span asp-validation-for="DateOfBirth"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Address" class="form-label">Địa chỉ (không bắt buộc)</label>
                    <input asp-for="Address" class="form-control" autocomplete="street-address" />
                    <span asp-validation-for="Address"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="password-field">
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="passwordHint" />
                        <button type="button" class="btn btn-link password-field__toggle" data-password-toggle aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">Hiện mật khẩu</span>
                        </button>
                    </div>
                    <div id="passwordHint" class="form-text">Ít nhất 8 ký tự, có chữ hoa, chữ thường, số và một ký tự trong @@$!%*?&amp;</div>
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="inline-error mt-4" role="alert"></div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Tiếp tục</button>
                <p class="auth-hint">Bước tiếp theo: nhập mã 6 số gửi tới email của bạn.</p>
            </div>
        </form>

        <p class="auth-alt">Đã có thẻ? <a asp-action="Login">Đăng nhập</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
