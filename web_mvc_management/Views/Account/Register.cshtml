@model web_mvc_management.Models.ViewModels.Auth.ReaderRegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Mở Thẻ Bạn Đọc";
    var readerTypes = ViewBag.ReaderTypes as List<web_mvc_management.Entity.ReaderType> ?? new();
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle p-3 mb-2 shadow-sm">
                    <i class="bi bi-person-vcard fs-2"></i>
                </div>
                <h4 class="fw-bold mb-1">Đăng Ký Mở Thẻ Thư Viện UTC</h4>
                <p class="text-white-50 small mb-0">Hệ thống cấp phát thẻ thư viện điện tử thông minh bảo mật 2 lớp OTP</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-action="Register" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4" role="alert"></div>

                    <div class="border-bottom pb-2 mb-4">
                        <h6 class="fw-bold text-primary text-uppercase mb-0">
                            <i class="bi bi-person-badge me-2"></i>1. Thông Tin Định Danh Bạn Đọc
                        </h6>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary small">HỌ VÀ TÊN <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Nguyễn Văn A" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold text-secondary small">TÊN ĐĂNG NHẬP <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-at"></i></span>
                                <input asp-for="Username" class="form-control border-start-0 ps-0" placeholder="nguyenvana" required autocomplete="username" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary small">ĐỊA CHỈ EMAIL <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="vana@student.utc.edu.vn" required autocomplete="email" />
                            </div>
                            <span class="text-muted small" style="font-size: 0.75rem;">Mã OTP xác thực mở thẻ sẽ gửi về email này</span>
                            <span asp-validation-for="Email" class="text-danger small d-block"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold text-secondary small">SỐ ĐIỆN THOẠI <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control border-start-0 ps-0" placeholder="0912345678" required autocomplete="tel" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ReaderTypeId" class="form-label fw-semibold text-secondary small">LOẠI ĐỘC GIẢ <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-mortarboard"></i></span>
                                <select asp-for="ReaderTypeId" class="form-select border-start-0 ps-0" required>
                                    <option value="">-- Chọn nhóm đối tượng --</option>
                                    @foreach (var type in readerTypes)
                                    {
                                        <option value="@type.Id">@type.Name (Mượn tối đa @type.MaxBorrowBooks cuốn / @type.LoanDays ngày)</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="ReaderTypeId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="MemberCode" class="form-label fw-semibold text-secondary small">MÃ SINH VIÊN / HỌC VIÊN</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-card-text"></i></span>
                                <input asp-for="MemberCode" class="form-control border-start-0 ps-0" placeholder="VD: 211200123" />
                            </div>
                            <span asp-validation-for="MemberCode" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold text-secondary small">NGÀY SINH</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="DateOfBirth" type="date" class="form-control border-start-0 ps-0" />
                            </div>
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Address" class="form-label fw-semibold text-secondary small">ĐỊA CHỈ THƯỜNG TRÚ</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Address" class="form-control border-start-0 ps-0" placeholder="Số nhà, đường, phường, quận..." />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="border-bottom pb-2 mt-4 mb-4">
                        <h6 class="fw-bold text-primary text-uppercase mb-0">
                            <i class="bi bi-shield-lock me-2"></i>2. Thiết Lập Mật Khẩu Đăng Nhập
                        </h6>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary small">MẬT KHẨU <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" type="password" id="regPasswordInput" class="form-control border-start-0 border-end-0 ps-0" placeholder="Tối thiểu 8 ký tự (hoa, thường, số, ký tự đặc biệt)" required autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary border-start-0" id="regTogglePasswordBtn">
                                    <i class="bi bi-eye" id="regTogglePasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small">XÁC NHẬN MẬT KHẨU <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Nhập lại mật khẩu..." required autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-light border small mt-4 p-3 rounded-3 text-secondary">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i>
                        Hệ thống sử dụng cơ chế bảo mật xác thực 2 lớp qua Email. Sau khi gửi thông tin, bạn sẽ được chuyển tới trang nhập mã OTP gồm 6 chữ số để kích hoạt thẻ.
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm">
                            <i class="bi bi-envelope-paper-heart me-1"></i>
                            Tiếp Tục &amp; Nhận Mã OTP Mở Thẻ &rarr;
                        </button>
                    </div>

                    <div class="text-center pt-3 border-top mt-4">
                        <p class="text-muted small mb-0">Đã có tài khoản thẻ thư viện? <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Đăng nhập tại đây</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Minimal JavaScript: Chỉ dùng để bật/tắt hiển thị mật khẩu
        $('#regTogglePasswordBtn').on('click', function () {
            const input = $('#regPasswordInput');
            const icon = $('#regTogglePasswordIcon');
            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
                icon.removeClass('bi-eye').addClass('bi-eye-slash');
            } else {
                input.attr('type', 'password');
                icon.removeClass('bi-eye-slash').addClass('bi-eye');
            }
        });
    </script>
}
