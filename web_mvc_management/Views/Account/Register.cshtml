@model web_mvc_management.Models.ViewModels.Auth.ReaderRegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Thẻ Bạn Đọc";
    var readerTypes = ViewBag.ReaderTypes as List<web_mvc_management.Entity.ReaderType> ?? new();
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-lg-8 col-xl-7">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle p-3 mb-2 shadow-sm">
                    <i class="bi bi-person-vcard fs-2"></i>
                </div>
                <h4 class="fw-bold mb-1">Đăng Ký Mở Thẻ Thư Viện UTC</h4>
                <p class="text-white-50 small mb-0">Hệ thống cấp phát thẻ thư viện điện tử thông minh và an toàn 2 lớp OTP</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <div id="registerAlertPlaceholder"></div>

                <form id="readerRegisterForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="border-bottom pb-2 mb-4">
                        <h6 class="fw-bold text-primary text-uppercase mb-0">
                            <i class="bi bi-person-badge me-2"></i>1. Thông Tin Định Danh Bạn Đọc
                        </h6>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary small">HỌ VÀ TÊN <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Nguyễn Văn A" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold text-secondary small">TÊN ĐĂNG NHẬP <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-at"></i></span>
                                <input asp-for="Username" class="form-control border-start-0 ps-0" placeholder="nguyenvana" required autocomplete="username" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary small">ĐỊA CHỈ EMAIL <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="vana@student.utc.edu.vn" required autocomplete="email" />
                            </div>
                            <span class="text-muted small" style="font-size: 0.75rem;">Mã OTP xác thực mở thẻ sẽ gửi về email này</span>
                            <span asp-validation-for="Email" class="text-danger small d-block"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold text-secondary small">SỐ ĐIỆN THOẠI <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control border-start-0 ps-0" placeholder="0912345678" required autocomplete="tel" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ReaderTypeId" class="form-label fw-semibold text-secondary small">LOẠI ĐỘC GIẢ <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-mortarboard"></i></span>
                                <select asp-for="ReaderTypeId" class="form-select border-start-0 ps-0" required>
                                    <option value="">-- Chọn nhóm đối tượng --</option>
                                    @foreach (var type in readerTypes)
                                    {
                                        <option value="@type.Id">@type.Name (Mượn tối đa @type.MaxBorrowBooks cuốn / @type.LoanDays ngày)</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="ReaderTypeId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="MemberCode" class="form-label fw-semibold text-secondary small">MÃ SINH VIÊN / HỌC VIÊN</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-card-text"></i></span>
                                <input asp-for="MemberCode" class="form-control border-start-0 ps-0" placeholder="VD: 211200123" />
                            </div>
                            <span asp-validation-for="MemberCode" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold text-secondary small">NGÀY SINH</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="DateOfBirth" type="date" class="form-control border-start-0 ps-0" />
                            </div>
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Address" class="form-label fw-semibold text-secondary small">ĐỊA CHỈ THƯỜNG TRÚ</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Address" class="form-control border-start-0 ps-0" placeholder="Số nhà, đường, phường, quận..." />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="border-bottom pb-2 mt-4 mb-4">
                        <h6 class="fw-bold text-primary text-uppercase mb-0">
                            <i class="bi bi-shield-lock me-2"></i>2. Thiết Lập Mật Khẩu Đăng Nhập
                        </h6>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary small">MẬT KHẨU <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" type="password" id="regPasswordInput" class="form-control border-start-0 border-end-0 ps-0" placeholder="Tối thiểu 8 ký tự (hoa, thường, số, ký tự đặc biệt)" required autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary border-start-0" id="regTogglePasswordBtn">
                                    <i class="bi bi-eye" id="regTogglePasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small">XÁC NHẬN MẬT KHẨU <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" type="password" id="regConfirmPasswordInput" class="form-control border-start-0 ps-0" placeholder="Nhập lại mật khẩu..." required autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-light border small mt-4 p-3 rounded-3 text-secondary">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i>
                        Sau khi bấm <strong>"Nhận mã OTP mở thẻ"</strong>, hệ thống sẽ gửi mã xác thực gồm 6 chữ số tới hòm thư email của bạn. Thẻ thư viện điện tử sẽ được khởi tạo tự động ngay khi xác thực thành công.
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" id="btnSubmitRegister" class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm">
                            <span class="spinner-border spinner-border-sm me-2 d-none" id="registerSpinner" role="status"></span>
                            <i class="bi bi-envelope-paper-heart me-1" id="registerBtnIcon"></i>
                            Nhận Mã OTP Mở Thẻ
                        </button>
                    </div>

                    <div class="text-center pt-3 border-top mt-4">
                        <p class="text-muted small mb-0">Đã có tài khoản thẻ thư viện? <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Đăng nhập tại đây</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL XÁC THỰC OTP MỞ THẺ (REGISTER OTP MODAL)                             -->
<!-- ========================================================================= -->
<div class="modal fade" id="registerOtpModal" tabindex="-1" aria-labelledby="registerOtpModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-envelope-check-fill fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="registerOtpModalLabel">Xác Thực Mã OTP Mở Thẻ</h5>
                        <p class="small text-white-50 mb-0">Kiểm tra hòm thư email để hoàn tất kích hoạt thẻ</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 text-center">
                <div id="registerModalAlertPlaceholder"></div>

                <div class="mb-3">
                    <p class="text-muted small mb-1">Mã xác thực gồm 6 chữ số đã được gửi tới:</p>
                    <p class="fw-bold text-dark fs-6" id="registerModalTargetEmail">-</p>
                </div>

                <!-- 6 Ô NHẬP OTP RIÊNG BIỆT -->
                <div class="d-flex justify-content-center gap-2 mb-3" id="registerOtpInputsContainer">
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 reg-otp-digit" style="width: 45px; height: 52px;" inputmode="numeric" autocomplete="one-time-code" />
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 reg-otp-digit" style="width: 45px; height: 52px;" inputmode="numeric" />
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 reg-otp-digit" style="width: 45px; height: 52px;" inputmode="numeric" />
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 reg-otp-digit" style="width: 45px; height: 52px;" inputmode="numeric" />
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 reg-otp-digit" style="width: 45px; height: 52px;" inputmode="numeric" />
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 reg-otp-digit" style="width: 45px; height: 52px;" inputmode="numeric" />
                </div>

                <div class="text-muted small mb-3">
                    <span>Mã OTP hết hạn sau: </span>
                    <span class="fw-bold text-danger" id="registerOtpCountdown">05:00</span>
                </div>

                <div class="d-grid mb-3">
                    <button type="button" id="btnConfirmRegisterOtp" class="btn btn-success py-2 fw-semibold rounded-3 shadow-sm">
                        <span class="spinner-border spinner-border-sm me-2 d-none" id="registerOtpVerifySpinner" role="status"></span>
                        <i class="bi bi-check-circle-fill me-1" id="registerOtpVerifyBtnIcon"></i>
                        Xác Nhận & Cấp Thẻ Thư Viện
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <button type="button" class="btn btn-link btn-sm text-decoration-none text-muted" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left me-1"></i>Sửa thông tin
                    </button>
                    <button type="button" id="btnResendRegisterOtp" class="btn btn-link btn-sm text-decoration-none text-primary fw-semibold" disabled>
                        <i class="bi bi-arrow-clockwise me-1"></i>Gửi lại mã (<span id="registerResendCooldown">60</span>s)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            let currentRegistrationData = null;
            let currentTargetEmail = '';
            let countdownInterval = null;
            let resendCooldownInterval = null;
            let otpExpirySeconds = 300;
            let resendCooldownSeconds = 60;

            const modalElement = document.getElementById('registerOtpModal');
            const otpModal = new bootstrap.Modal(modalElement);

            // Toggle show/hide password
            $('#regTogglePasswordBtn').on('click', function () {
                const input = $('#regPasswordInput');
                const icon = $('#regTogglePasswordIcon');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });

            // Gửi dữ liệu form đăng ký -> nhận OTP
            $('#readerRegisterForm').on('submit', function (e) {
                e.preventDefault();

                if (!$(this).valid()) {
                    return;
                }

                const formData = {
                    FullName: $('#FullName').val().trim(),
                    Username: $('#Username').val().trim(),
                    Email: $('#Email').val().trim(),
                    Phone: $('#Phone').val().trim(),
                    ReaderTypeId: $('#ReaderTypeId').val(),
                    MemberCode: $('#MemberCode').val().trim() || null,
                    DateOfBirth: $('#DateOfBirth').val() || null,
                    Address: $('#Address').val().trim() || null,
                    Password: $('#regPasswordInput').val(),
                    ConfirmPassword: $('#regConfirmPasswordInput').val()
                };

                const token = $('input[name="__RequestVerificationToken"]').val();

                $('#btnSubmitRegister').prop('disabled', true);
                $('#registerSpinner').removeClass('d-none');
                $('#registerBtnIcon').addClass('d-none');
                $('#registerAlertPlaceholder').empty();

                $.ajax({
                    url: '@Url.Action("SendRegisterOtp", "Account")',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    data: JSON.stringify(formData),
                    success: function (res) {
                        $('#btnSubmitRegister').prop('disabled', false);
                        $('#registerSpinner').addClass('d-none');
                        $('#registerBtnIcon').removeClass('d-none');

                        if (res.success) {
                            currentRegistrationData = formData;
                            currentTargetEmail = res.data.email;
                            $('#registerModalTargetEmail').text(res.data.maskedEmail);

                            clearOtpInputs();
                            startCountdown();
                            startResendCooldown();

                            otpModal.show();
                            setTimeout(() => {
                                $('.reg-otp-digit').first().focus();
                            }, 500);
                        } else {
                            showErrorAlert('#registerAlertPlaceholder', res.message || 'Không thể gửi mã OTP.');
                        }
                    },
                    error: function (xhr) {
                        $('#btnSubmitRegister').prop('disabled', false);
                        $('#registerSpinner').addClass('d-none');
                        $('#registerBtnIcon').removeClass('d-none');

                        let errMsg = 'Đã có lỗi hệ thống xảy ra. Vui lòng thử lại sau.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errMsg = xhr.responseJSON.message;
                        }
                        showErrorAlert('#registerAlertPlaceholder', errMsg);
                    }
                });
            });

            // Xử lý 6 ô nhập OTP
            const $otpInputs = $('.reg-otp-digit');
            $otpInputs.each(function (index) {
                $(this).on('input', function (e) {
                    const val = $(this).val();
                    if (val.length === 1) {
                        if (index < $otpInputs.length - 1) {
                            $otpInputs.eq(index + 1).focus();
                        } else {
                            $(this).blur();
                            $('#btnConfirmRegisterOtp').click();
                        }
                    }
                });

                $(this).on('keydown', function (e) {
                    if (e.key === 'Backspace' && !$(this).val() && index > 0) {
                        $otpInputs.eq(index - 1).focus();
                    }
                });

                $(this).on('paste', function (e) {
                    e.preventDefault();
                    const pasteData = (e.originalEvent.clipboardData || window.clipboardData).getData('text').trim();
                    if (/^\d{6}$/.test(pasteData)) {
                        pasteData.split('').forEach((char, i) => {
                            if (i < $otpInputs.length) {
                                $otpInputs.eq(i).val(char);
                            }
                        });
                        $otpInputs.last().focus();
                        $('#btnConfirmRegisterOtp').click();
                    }
                });
            });

            // Xác nhận mã OTP và cấp thẻ
            $('#btnConfirmRegisterOtp').on('click', function () {
                let otp = '';
                $otpInputs.each(function () {
                    otp += $(this).val();
                });

                if (otp.length !== 6) {
                    showErrorAlert('#registerModalAlertPlaceholder', 'Vui lòng nhập đủ 6 chữ số mã OTP.');
                    return;
                }

                if (!currentRegistrationData) {
                    showErrorAlert('#registerModalAlertPlaceholder', 'Dữ liệu đăng ký không tồn tại. Vui lòng thử lại từ đầu.');
                    return;
                }

                const token = $('input[name="__RequestVerificationToken"]').val();

                $('#btnConfirmRegisterOtp').prop('disabled', true);
                $('#registerOtpVerifySpinner').removeClass('d-none');
                $('#registerOtpVerifyBtnIcon').addClass('d-none');
                $('#registerModalAlertPlaceholder').empty();

                $.ajax({
                    url: '@Url.Action("CompleteRegistration", "Account")',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    data: JSON.stringify({
                        RegistrationData: currentRegistrationData,
                        OtpCode: otp
                    }),
                    success: function (res) {
                        $('#btnConfirmRegisterOtp').prop('disabled', false);
                        $('#registerOtpVerifySpinner').addClass('d-none');
                        $('#registerOtpVerifyBtnIcon').removeClass('d-none');

                        if (res.success) {
                            const cardInfo = res.data && res.data.cardNo ? ` Mã số thẻ: <strong>${res.data.cardNo}</strong>.` : '';
                            $('#registerModalAlertPlaceholder').html(
                                `<div class="alert alert-success d-flex align-items-center mb-3">
                                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                                    <div>Đăng ký thành công!${cardInfo} Đang chuyển hướng tới trang đăng nhập...</div>
                                </div>`
                            );
                            setTimeout(() => {
                                window.location.href = res.data.redirectUrl || '@Url.Action("Login", "Account")';
                            }, 2000);
                        } else {
                            showErrorAlert('#registerModalAlertPlaceholder', res.message || 'Mã OTP không hợp lệ hoặc đã hết hạn.');
                            clearOtpInputs();
                            $otpInputs.first().focus();
                        }
                    },
                    error: function (xhr) {
                        $('#btnConfirmRegisterOtp').prop('disabled', false);
                        $('#registerOtpVerifySpinner').addClass('d-none');
                        $('#registerOtpVerifyBtnIcon').removeClass('d-none');

                        let errMsg = 'Xác thực thất bại. Vui lòng thử lại.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errMsg = xhr.responseJSON.message;
                        }
                        showErrorAlert('#registerModalAlertPlaceholder', errMsg);
                        clearOtpInputs();
                        $otpInputs.first().focus();
                    }
                });
            });

            // Gửi lại mã OTP
            $('#btnResendRegisterOtp').on('click', function () {
                if ($(this).prop('disabled') || !currentTargetEmail) return;

                const token = $('input[name="__RequestVerificationToken"]').val();
                $(this).prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("ResendOtp", "Account")',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    data: JSON.stringify({
                        Email: currentTargetEmail,
                        Purpose: '@web_mvc_management.Services.AuthService.PurposeRegister'
                    }),
                    success: function (res) {
                        if (res.success) {
                            $('#registerModalAlertPlaceholder').html(
                                `<div class="alert alert-info py-2 small mb-3">
                                    <i class="bi bi-info-circle-fill me-1"></i>${res.message || 'Mã OTP mới đã được gửi.'}
                                </div>`
                            );
                            clearOtpInputs();
                            startCountdown();
                            startResendCooldown();
                            $otpInputs.first().focus();
                        } else {
                            showErrorAlert('#registerModalAlertPlaceholder', res.message || 'Không thể gửi lại mã OTP.');
                        }
                    },
                    error: function (xhr) {
                        let errMsg = 'Lỗi gửi lại mã OTP.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errMsg = xhr.responseJSON.message;
                        }
                        showErrorAlert('#registerModalAlertPlaceholder', errMsg);
                    }
                });
            });

            function startCountdown() {
                clearInterval(countdownInterval);
                otpExpirySeconds = 300;
                updateCountdownDisplay();
                countdownInterval = setInterval(() => {
                    otpExpirySeconds--;
                    updateCountdownDisplay();
                    if (otpExpirySeconds <= 0) {
                        clearInterval(countdownInterval);
                        $('#registerOtpCountdown').text('00:00 (Hết hạn)');
                        showErrorAlert('#registerModalAlertPlaceholder', 'Mã OTP đã hết hiệu lực. Vui lòng bấm "Gửi lại mã".');
                    }
                }, 1000);
            }

            function updateCountdownDisplay() {
                const m = Math.floor(otpExpirySeconds / 60);
                const s = otpExpirySeconds % 60;
                $('#registerOtpCountdown').text(`${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`);
            }

            function startResendCooldown() {
                clearInterval(resendCooldownInterval);
                resendCooldownSeconds = 60;
                $('#btnResendRegisterOtp').prop('disabled', true);
                $('#registerResendCooldown').text(resendCooldownSeconds);

                resendCooldownInterval = setInterval(() => {
                    resendCooldownSeconds--;
                    $('#registerResendCooldown').text(resendCooldownSeconds);
                    if (resendCooldownSeconds <= 0) {
                        clearInterval(resendCooldownInterval);
                        $('#btnResendRegisterOtp').prop('disabled', false).html('<i class="bi bi-arrow-clockwise me-1"></i>Gửi lại mã OTP');
                    }
                }, 1000);
            }

            function clearOtpInputs() {
                $otpInputs.val('');
            }

            function showErrorAlert(containerId, message) {
                $(containerId).html(
                    `<div class="alert alert-danger alert-dismissible fade show small mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>${message}
                        <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`
                );
            }
        });
    </script>
}
