@model web_mvc_management.Models.ViewModels.AdminCatalog.ShelfPageViewModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Quản lý vị trí kệ sách";
    ViewData["Screen"] = ScreenId.ManageShelves;
}

<div class="staff-page-head">
    <div>
        <h1>Quản lý vị trí kệ sách</h1>
        <p class="text-muted-ink mb-0">Định danh mã kệ và vị trí lưu trữ cho từng bản sao sách trong kho.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#shelfModal" onclick="openShelfModal()">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>Thêm vị trí kệ
    </button>
</div>

<form method="get" action="@Screens.GetPath(ScreenId.ManageShelves)" class="panel mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="shelfKeyword">Tìm kiếm kệ sách <kbd>/</kbd></label>
            <input type="search" class="form-control" id="shelfKeyword" name="Keyword" value="@Model.Filter.Keyword" data-search-input placeholder="Mã kệ (VD: KE-IT-01) hoặc mô tả tầng/khu vực..." />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="shelfStatus">Trạng thái</label>
            <select class="form-select" id="shelfStatus" name="Status">
                <option value="">Đang dùng (Mặc định)</option>
                <option value="@EntityStatus.Active" selected="@(Model.Filter.Status == EntityStatus.Active)">Đang hoạt động (ACTIVE)</option>
                <option value="@EntityStatus.Inactive" selected="@(Model.Filter.Status == EntityStatus.Inactive)">Tạm ngưng (INACTIVE)</option>
                <option value="@EntityStatus.Deleted" selected="@(Model.Filter.Status == EntityStatus.Deleted)">Đã xóa mềm (DELETED)</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Lọc</button>
        </div>
    </div>
</form>

<div class="table-frame mb-2">
    <table class="table table-hover data-table">
        <thead>
            <tr>
                <th scope="col">Mã vị trí kệ</th>
                <th scope="col">Khu vực / Mô tả</th>
                <th scope="col" class="num">Bản sao trên kệ (Sẵn / Tổng)</th>
                <th scope="col">Trạng thái</th>
                <th scope="col" class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PagedItems.Items.Count == 0)
            {
                <tr>
                    <td colspan="5">
                        <div class="state-block text-center">
                            <div class="state-block__title">Chưa có kệ sách phù hợp</div>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.PagedItems.Items)
                {
                    <tr>
                        <td class="num fw-medium" style="text-align:left">@item.Code</td>
                        <td class="text-muted-ink">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                        <td class="num">
                            <a href="@Screens.GetPath(ScreenId.ManageBookCopies)?ShelfId=@item.Id" class="text-decoration-none">
                                @item.AvailableCopyCount / @item.CopyCount cuốn
                            </a>
                        </td>
                        <td>
                            @if (item.Status == EntityStatus.Deleted)
                            {
                                <span class="status status--danger">Đã xóa mềm (DELETED)</span>
                            }
                            else
                            {
                                <span class="status @(item.Status == EntityStatus.Active ? "status--ok" : "status--neutral")">
                                    @(item.Status == EntityStatus.Active ? "Đang dùng" : "Tạm ngưng")
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                @if (item.Status == EntityStatus.Deleted)
                                {
                                    <form method="post" action="@Screens.GetPath(ScreenId.ManageShelves)/Restore/@item.Id" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-quiet btn-sm">Khôi phục</button>
                                    </form>
                                    <form method="post" action="@Screens.GetPath(ScreenId.ManageShelves)/HardDelete/@item.Id" class="d-inline"
                                          data-hard-delete="Vị trí kệ '@item.Code'">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">Xóa vĩnh viễn</button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-quiet btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#shelfModal"
                                            data-id="@item.Id"
                                            data-code="@item.Code"
                                            data-desc="@item.Description"
                                            data-status="@item.Status"
                                            onclick="openShelfModal(this)">
                                        Sửa
                                    </button>
                                    <form method="post" action="@Screens.GetPath(ScreenId.ManageShelves)/Delete/@item.Id" class="d-inline"
                                          data-confirm="Bước 1: Xóa mềm vị trí kệ '@item.Code'?"
                                          data-confirm-detail="Vị trí kệ sẽ chuyển sang trạng thái DELETED (xóa mềm). Chỉ xóa mềm được khi không còn bản sao sách đang lưu hành trên kệ này."
                                          data-confirm-ok="Xóa mềm (DELETED)"
                                          data-confirm-cancel="Giữ lại"
                                          data-confirm-danger>
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-quiet btn-sm text-danger">Xóa mềm</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.PagedItems" />

<div class="modal fade" id="shelfModal" tabindex="-1" aria-labelledby="shelfModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="@Screens.GetPath(ScreenId.ManageShelves)/Save">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="shelfId" />
                <div class="modal-header">
                    <h2 class="modal-title" id="shelfModalTitle">Thêm vị trí kệ sách</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="shelfCode">Mã vị trí kệ</label>
                        <input type="text" class="form-control num" id="shelfCode" name="Code" required maxlength="30" placeholder="VD: KE-IT-03" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="shelfDesc">Mô tả tầng / Khu vực</label>
                        <textarea class="form-control" id="shelfDesc" name="Description" rows="2" maxlength="255" placeholder="VD: Tầng 1 - Dãy B - Khoa CNTT"></textarea>
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="shelfStatusSelect">Trạng thái</label>
                        <select class="form-select" id="shelfStatusSelect" name="Status">
                            <option value="@EntityStatus.Active">Đang hoạt động (ACTIVE)</option>
                            <option value="@EntityStatus.Inactive">Tạm ngưng (INACTIVE)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openShelfModal(btn) {
            document.getElementById('shelfModalTitle').textContent = btn ? 'Cập nhật vị trí kệ' : 'Thêm vị trí kệ sách';
            document.getElementById('shelfId').value = btn ? (btn.dataset.id || '') : '';
            document.getElementById('shelfCode').value = btn ? (btn.dataset.code || '') : '';
            document.getElementById('shelfDesc').value = btn ? (btn.dataset.desc || '') : '';
            document.getElementById('shelfStatusSelect').value = btn ? (btn.dataset.status || 'ACTIVE') : 'ACTIVE';
        }
    </script>
}

