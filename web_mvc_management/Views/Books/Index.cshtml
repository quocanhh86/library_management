@model web_mvc_management.Models.ViewModels.Catalog.CatalogViewModel
@{
    ViewData["Title"] = "Tra cứu sách";
}
<div class="catalog-heading">
    <a href="/">Trang chủ</a>
    <h1 class="page-title mt-3">Tra cứu danh mục sách</h1>
    <p class="text-muted-ink">Tìm tài liệu theo thể loại, tác giả, nhà xuất bản, năm xuất bản và kiểm tra số bản sao có sẵn trên kệ.</p>
</div>

<form method="get" action="@Screens.GetPath(ScreenId.BookCatalog)" class="catalog-filters">
    <div>
        <label class="form-label" for="catalogKeyword">Tên sách, tác giả hoặc ISBN</label>
        <input class="form-control" type="search" id="catalogKeyword" name="keyword" value="@Model.Keyword" placeholder="Nhập từ khóa..." />
    </div>
    <div>
        <label class="form-label" for="catalogCategory">Thể loại</label>
        <select class="form-select" id="catalogCategory" name="category">
            <option value="">Tất cả thể loại</option>
            @foreach (var topic in Model.Topics)
            {
                <option value="@topic.Key" selected="@(topic.Key == Model.Category)">@topic.Name</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label" for="catalogYear">Năm xuất bản</label>
        <input class="form-control num" type="number" id="catalogYear" name="year" min="1800" max="2100" value="@Model.Year" placeholder="VD: 2023" />
    </div>
    <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i>Tìm sách</button>

    <div class="catalog-filters__bottom d-flex flex-wrap align-items-center gap-3 w-100 mt-2">
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 fs-xs text-muted-ink" for="catalogAuthor">Tác giả:</label>
            <select class="form-select form-select-sm" style="width: auto; min-width: 180px;" id="catalogAuthor" name="authorId" onchange="this.form.submit()">
                <option value="">Tất cả tác giả</option>
                @foreach (var author in Model.Authors)
                {
                    <option value="@author.Id" selected="@(Model.AuthorId == author.Id)">@author.Name</option>
                }
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 fs-xs text-muted-ink" for="catalogPublisher">Nhà xuất bản:</label>
            <select class="form-select form-select-sm" style="width: auto; min-width: 180px;" id="catalogPublisher" name="publisherId" onchange="this.form.submit()">
                <option value="">Tất cả NXB</option>
                @foreach (var pub in Model.Publishers)
                {
                    <option value="@pub.Id" selected="@(Model.PublisherId == pub.Id)">@pub.Name</option>
                }
            </select>
        </div>
        <label class="catalog-filter-check ms-auto">
            <input class="form-check-input" type="checkbox" name="available" value="true" checked="@Model.Available" onchange="this.form.submit()" />
            Chỉ sách còn bản sẵn sàng
        </label>
        <a href="@Screens.GetPath(ScreenId.BookCatalog)">Xóa bộ lọc</a>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <p role="status" class="catalog-count mb-0">Tìm thấy <strong>@Model.TotalCount</strong> đầu sách</p>
    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Librarian))
    {
        <a class="btn btn-quiet btn-sm" href="@Screens.GetPath(ScreenId.ManageBooks)">
            <i class="bi bi-gear" aria-hidden="true"></i>Quản lý kho sách
        </a>
    }
</div>

@if (Model.Books.Count == 0)
{
    <div class="library-empty">
        <i class="bi bi-search" aria-hidden="true"></i>
        <h2>Chưa tìm thấy tài liệu phù hợp</h2>
        <p>Thử rút gọn từ khóa, kiểm tra chính tả hoặc bỏ bớt bộ lọc.</p>
        <a href="@Screens.GetPath(ScreenId.BookCatalog)">Xem toàn bộ danh mục</a>
    </div>
}
else
{
    <ul class="book-list">
        @foreach (var book in Model.Books)
        {
            <li><partial name="_BookRow" model="book" /></li>
        }
    </ul>
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-between align-items-center mt-4" aria-label="Phân trang danh mục">
            @if (Model.Page > 1)
            {
                <a class="btn btn-quiet" asp-action="Index"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-category="@Model.Category"
                   asp-route-authorId="@Model.AuthorId"
                   asp-route-publisherId="@Model.PublisherId"
                   asp-route-year="@Model.Year"
                   asp-route-available="@Model.Available"
                   asp-route-page="@(Model.Page - 1)">Trang trước</a>
            }
            else
            {
                <span></span>
            }
            <span class="catalog-count">Trang @Model.Page / @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-quiet" asp-action="Index"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-category="@Model.Category"
                   asp-route-authorId="@Model.AuthorId"
                   asp-route-publisherId="@Model.PublisherId"
                   asp-route-year="@Model.Year"
                   asp-route-available="@Model.Available"
                   asp-route-page="@(Model.Page + 1)">Trang sau</a>
            }
            else
            {
                <span></span>
            }
        </nav>
    }
}
