@model AdminDashboardViewModel
@{
    var preview = ViewData["AdminPreview"] is true;
    var role = User.IsInRole(AppRoles.Admin) ? AppRoles.Admin : AppRoles.Librarian;
    string Link(ScreenId screen, string? query = null) => AdminNavigation.Path(screen, preview, role, query);
}
<div class="admin-page-head"><div><p class="admin-eyebrow">Phân tích thư viện</p><h1>Báo cáo thư viện</h1><p>Tổng hợp dữ liệu hiện có để theo dõi kho sách và tình hình lưu thông.</p></div><span class="admin-report-period"><i class="bi bi-calendar3" aria-hidden="true"></i>Tại ngày @Model.Today.ToString("dd/MM/yyyy")</span></div>
<div class="admin-report-summary"><div><span>Đầu sách</span><strong>@Model.TotalBooks</strong></div><div><span>Tổng số bản</span><strong>@Model.TotalCopies</strong></div><div><span>Bản sẵn sàng</span><strong>@Model.AvailableCopies</strong></div><div><span>Phiếu quá hạn</span><strong>@Model.Overdue.Count</strong></div></div>
<div class="admin-report-grid"><section class="admin-panel"><div class="admin-panel__head"><div><h2>Cơ cấu tài liệu theo chuyên ngành</h2><p>Số đầu sách phân loại trong danh mục hiện tại.</p></div></div><div class="admin-report-bars">@foreach(var category in Model.Categories){<a href="@Link(ScreenId.ManageBooks, "group=" + Uri.EscapeDataString(category.Name))"><span>@category.Name</span><meter min="0" max="@Math.Max(Model.TotalBooks,1)" value="@category.Count" aria-label="@category.Name">@category.Count</meter><strong>@category.Count <small>đầu sách</small></strong></a>}</div></section><aside class="admin-panel"><div class="admin-panel__head"><h2>Tình trạng bản sao</h2></div><div class="admin-report-availability"><strong>@Math.Round(Model.AvailableCopies * 100m / Math.Max(Model.TotalCopies, 1))<span>%</span></strong><p>Bản sao sẵn sàng phục vụ</p><meter min="0" max="@Math.Max(Model.TotalCopies, 1)" value="@Model.AvailableCopies" aria-label="Tỷ lệ bản sao sẵn sàng">@Model.AvailableCopies</meter><dl><dt>Sẵn sàng</dt><dd>@Model.AvailableCopies bản</dd><dt>Chưa sẵn sàng</dt><dd>@(Model.TotalCopies - Model.AvailableCopies) bản</dd></dl><a href="@Link(ScreenId.ManageBookCopies)">Kiểm tra từng bản sao <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div></aside></div>
<section class="admin-panel admin-report-overdue"><div class="admin-panel__head"><div><h2>Chi tiết tài liệu quá hạn</h2><p>Đối chiếu hạn trả và liên hệ bạn đọc trước khi xử lý tại quầy.</p></div><a href="@Link(ScreenId.CirculationHistory,"status=OVERDUE")">Mở danh sách phiếu</a></div><div class="admin-table-scroll"><table class="admin-table"><caption class="visually-hidden">Chi tiết tài liệu quá hạn</caption><thead><tr><th scope="col">Mã phiếu</th><th scope="col">Độc giả</th><th scope="col">Tài liệu</th><th scope="col">Hạn trả</th><th scope="col" class="admin-numeric">Số ngày trễ</th></tr></thead><tbody>@foreach(var loan in Model.Overdue){<tr><td class="admin-code">@loan.Code</td><td>@loan.ReaderName</td><td>@loan.BookTitle</td><td>@loan.DueOn.ToString("dd/MM/yyyy")</td><td class="admin-numeric admin-danger">@(Model.Today.DayNumber-loan.DueOn.DayNumber) ngày</td></tr>}@if(Model.Overdue.Count == 0){<tr><td colspan="5">Không có tài liệu quá hạn.</td></tr>}</tbody></table></div></section>
