@model AdminSettingsViewModel
<div class="admin-page-head"><div><p class="admin-eyebrow">Quản trị hệ thống</p><h1>Quy định mượn trả</h1><p>Thiết lập hạn mức cho bạn đọc và mức phạt khi tài liệu được trả trễ.</p></div><span class="admin-access-note"><i class="bi bi-shield-lock" aria-hidden="true"></i>Chỉ quản trị viên</span></div>
<form class="admin-settings" data-admin-settings novalidate>
    <section class="admin-panel"><div class="admin-panel__head"><div><h2>Hạn mức theo loại độc giả</h2><p>Số đầu sách tối đa được mượn cùng lúc và thời gian mượn tương ứng.</p></div><i class="bi bi-person-vcard" aria-hidden="true"></i></div><div class="admin-settings-rows">
        @for(var i = 0; i < Model.Info.LoanRules.Count; i++)
        {
            var rule = Model.Info.LoanRules[i];
            <div class="admin-settings-row"><div><h3>@rule.ReaderTypeName</h3><p>Áp dụng cho thẻ thư viện còn hạn.</p></div><div><label class="form-label" for="maxBooks_@i">Số sách tối đa</label><div class="admin-input-unit"><input id="maxBooks_@i" name="Rules[@i].MaxBooks" class="form-control" type="number" value="@rule.MaxBooks" min="1" max="100" required /><span>cuốn</span></div></div><div><label class="form-label" for="loanDays_@i">Thời hạn mượn</label><div class="admin-input-unit"><input id="loanDays_@i" name="Rules[@i].LoanDays" class="form-control" type="number" value="@rule.LoanDays" min="1" max="365" required /><span>ngày</span></div></div></div>
        }
    </div></section>
    <section class="admin-panel"><div class="admin-panel__head"><div><h2>Phạt trả quá hạn</h2><p>Mức phạt dự kiến được tính trên mỗi bản sách và số ngày trả trễ.</p></div><i class="bi bi-cash-coin" aria-hidden="true"></i></div><div class="admin-settings-fine"><div><label class="form-label" for="finePerDay">Tiền phạt mỗi ngày</label><div class="admin-input-unit"><input class="form-control" id="finePerDay" name="OverdueFinePerDay" type="number" value="@Model.Info.OverdueFinePerDay.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" min="0" max="1000000" step="100" required /><span>₫ / ngày</span></div></div><p><i class="bi bi-info-circle" aria-hidden="true"></i>Phạt do hỏng hoặc mất tài liệu cần được thủ thư xác nhận theo từng trường hợp.</p></div></section>
    <section class="admin-panel"><div class="admin-panel__head"><div><h2>Hỏng, mất và ngưỡng nợ phạt</h2><p>Giá trị mẫu theo cấu hình khởi tạo của thư viện.</p></div></div><div class="admin-settings-rows">
        <div class="admin-settings-row"><div><h3>Tỷ lệ phạt theo giá trị bản sao</h3><p>Cần xác nhận tình trạng và giá trị tài liệu.</p></div><div><label class="form-label" for="damagedPercent">Tài liệu hỏng</label><div class="admin-input-unit"><input id="damagedPercent" class="form-control" name="DamagedFinePercent" type="number" value="@Model.DamagedFinePercent" min="0" max="1000" required /><span>%</span></div></div><div><label class="form-label" for="lostPercent">Tài liệu mất</label><div class="admin-input-unit"><input id="lostPercent" class="form-control" name="LostFinePercent" type="number" value="@Model.LostFinePercent" min="0" max="1000" required /><span>%</span></div></div></div>
        <div class="admin-settings-row"><div><h3>Ngưỡng nợ phạt</h3><p>Đối chiếu khoản nợ khi xử lý nghiệp vụ.</p></div><div><label class="form-label" for="maxUnpaid">Số tiền</label><div class="admin-input-unit"><input id="maxUnpaid" class="form-control" name="MaxUnpaidFine" type="number" value="@Model.MaxUnpaidFine.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" min="0" step="100" required /><span>₫</span></div></div><div><label class="form-label" for="holdHours">Thời gian giữ chỗ</label><div class="admin-input-unit"><input id="holdHours" class="form-control" type="number" value="@Model.ReservationHoldHours" disabled /><span>giờ</span></div><p>Áp dụng khi mở chức năng đặt trước.</p></div></div>
    </div></section>
    <div class="admin-settings-footer"><p class="admin-validation-result" role="status" hidden data-admin-validation>Thông tin hợp lệ. Đây là bản xem thử; quy định chưa được lưu.</p><button class="btn btn-quiet" type="reset">Khôi phục giá trị ban đầu</button><button class="btn btn-primary" type="submit"><i class="bi bi-check2" aria-hidden="true"></i>Kiểm tra cấu hình</button></div>
</form>
