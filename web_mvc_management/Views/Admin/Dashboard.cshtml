@model AdminDashboardViewModel
@{
    var preview = ViewData["AdminPreview"] is true;
    var role = User.IsInRole(AppRoles.Admin) ? AppRoles.Admin : AppRoles.Librarian;
    string Link(ScreenId screen, string? query = null) => AdminNavigation.Path(screen, preview, role, query);
}
<div class="admin-page-head"><div><p class="admin-eyebrow">Không gian làm việc</p><h1>Tổng quan vận hành</h1><p>Theo dõi lưu thông tài liệu và những việc cần xử lý tại thư viện.</p></div><a class="btn btn-primary" href="@Link(ScreenId.CirculationBorrow)"><i class="bi bi-plus-lg" aria-hidden="true"></i>Lập phiếu mượn</a></div>
<section class="admin-metrics" aria-label="Tình hình thư viện">
    @foreach (var metric in Model.Metrics)
    {
        <a class="admin-metric" href="@Link(metric.Destination, metric.Filter)"><span class="admin-metric__label">@metric.Label<i class="bi bi-@metric.Icon" aria-hidden="true"></i></span><strong>@metric.Value</strong><span class="admin-metric__note">@metric.Note <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span></a>
    }
</section>
<div class="admin-dashboard-grid">
    <section class="admin-panel admin-overdue" aria-labelledby="overdueTitle"><div class="admin-panel__head"><div><span class="admin-section-label">Ưu tiên xử lý</span><h2 id="overdueTitle">Tài liệu đang quá hạn <span class="admin-count">@Model.Overdue.Count</span></h2></div><a href="@Link(ScreenId.CirculationHistory, "status=OVERDUE")">Xem tất cả <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
        @if (Model.Overdue.Count == 0){<div class="admin-empty"><i class="bi bi-check-circle" aria-hidden="true"></i><h3>Không có tài liệu quá hạn</h3><p>Các phiếu mượn đang trong thời hạn trả.</p></div>}
        else
        {
            <ul class="admin-overdue-list">@foreach (var loan in Model.Overdue){<li><partial name="_DueStamp" model="new DueStamp(loan.DueOn, Model.Today)" /><div><a href="@Link(ScreenId.CirculationHistory, "keyword=" + Uri.EscapeDataString(loan.Code))">@loan.BookTitle</a><p>@loan.ReaderName <span class="admin-inline-code">@loan.CardNo</span></p><span class="admin-overdue-label">Quá hạn @(Model.Today.DayNumber - loan.DueOn.DayNumber) ngày</span></div><a class="admin-row-link" href="@Link(ScreenId.CirculationReturn, "card=" + loan.CardNo)">Nhận trả <i class="bi bi-arrow-right" aria-hidden="true"></i></a></li>}</ul>
        }
    </section>
    <aside class="admin-panel admin-task-panel" aria-labelledby="taskTitle"><div class="admin-panel__head"><h2 id="taskTitle">Việc cần làm</h2><i class="bi bi-list-check" aria-hidden="true"></i></div><a class="admin-task" href="@Link(ScreenId.ManageReaders, "status=EXPIRING")"><span class="admin-task__icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></span><span><strong>Thẻ sắp hết hạn</strong><small>@Model.ExpiringReaders.Count thẻ trong 30 ngày tới</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a><a class="admin-task" href="@Link(ScreenId.ManageFines)"><span class="admin-task__icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></span><span><strong>Kiểm tra khoản phạt</strong><small>Đối chiếu tài liệu trả trễ</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a><a class="admin-task" href="@Link(ScreenId.CirculationHistory, "status=DUE_SOON")"><span class="admin-task__icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span><span><strong>Phiếu sắp đến hạn</strong><small>Chuẩn bị nhắc bạn đọc trả sách</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a><div class="admin-task-note"><i class="bi bi-bookmark-check" aria-hidden="true"></i><p>Kiểm tra thẻ và tình trạng bản sao trước khi lập phiếu mượn.</p></div></aside>
    <section class="admin-panel" aria-labelledby="recentTitle"><div class="admin-panel__head"><h2 id="recentTitle">Phiếu mượn gần đây</h2><a href="@Link(ScreenId.CirculationHistory)">Danh sách phiếu <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div><div class="admin-table-scroll"><table class="admin-table"><caption class="visually-hidden">Các phiếu mượn gần đây trong dữ liệu mẫu</caption><thead><tr><th scope="col">Mã phiếu / độc giả</th><th scope="col">Tài liệu</th><th scope="col">Hạn trả</th><th scope="col">Trạng thái</th></tr></thead><tbody>@foreach (var loan in Model.RecentLoans){<tr><td><a class="admin-code" href="@Link(ScreenId.CirculationHistory, "keyword=" + loan.Code)">@loan.Code</a><small>@loan.ReaderName</small></td><td>@loan.BookTitle</td><td class="admin-nowrap">@loan.DueOn.ToString("dd/MM/yyyy")</td><td><partial name="_StatusBadge" model="new StatusBadge(StatusKind.Loan, loan.Returned ? StatusBadge.Loan.Returned : loan.DueOn < Model.Today ? StatusBadge.Loan.Overdue : loan.DueOn <= Model.Today.AddDays(DueStamp.DueSoonDays) ? StatusBadge.Loan.DueSoon : StatusBadge.Loan.Active)" /></td></tr>}</tbody></table></div></section>
    <section class="admin-panel" aria-labelledby="inventoryTitle"><div class="admin-panel__head"><h2 id="inventoryTitle">Phân bố kho tài liệu</h2><span class="admin-muted">@Model.TotalBooks đầu sách</span></div><div class="admin-inventory">@foreach (var category in Model.Categories){<a href="@Link(ScreenId.ManageBooks, "group=" + Uri.EscapeDataString(category.Name))"><span>@category.Name<strong>@category.Count</strong></span><meter min="0" max="@Math.Max(Model.TotalBooks, 1)" value="@category.Count" aria-label="@category.Name: @category.Count đầu sách">@category.Count</meter></a>}<p><strong>@Model.AvailableCopies/@Model.TotalCopies</strong> bản sách đang sẵn sàng phục vụ.</p></div></section>
</div>
