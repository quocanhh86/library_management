@model web_mvc_management.Models.ViewModels.Reader.ReaderPortalPageViewModel
@{
    ViewData["Title"] = "Sách đặt trước của tôi";
}

<section class="portal-section">
    <div class="portal-container">
        <div class="portal-section__head">
            <div>
                <p class="portal-kicker">Không gian bạn đọc</p>
                <h1>Danh sách đặt trước sách</h1>
                <p class="portal-section__description">Theo dõi trạng thái giữ chỗ các đầu sách đã đăng ký đặt trước.</p>
            </div>
            <a class="btn btn-quiet" href="@Screens.GetPath(ScreenId.ReaderProfile)">Về thẻ thư viện</a>
        </div>

        <div class="table-frame">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Đầu sách</th>
                        <th>Bản sao giữ chỗ</th>
                        <th>Ngày đặt</th>
                        <th>Hạn nhận sách</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reservations.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted-ink">Bạn chưa có yêu cầu đặt trước sách nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model.Reservations)
                        {
                            <tr>
                                <td>
                                    <div class="fw-medium">@r.BookTitle</div>
                                    <div class="fs-xs text-muted-ink">@r.Authors</div>
                                </td>
                                <td class="num">@(r.AssignedBarcode ?? "Chờ bản sao")</td>
                                <td class="num">@r.ReservedAt.ToString(AppConstants.DefaultDateTimeFormat)</td>
                                <td class="num">@(r.ExpiresAt?.ToString(AppConstants.DefaultDateTimeFormat) ?? "—")</td>
                                <td><partial name="_StatusBadge" model="new StatusBadge(StatusKind.Reservation, r.ReservationStatus)" /></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

