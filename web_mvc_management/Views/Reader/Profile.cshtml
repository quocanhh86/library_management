@model web_mvc_management.Models.ViewModels.Reader.ReaderPortalPageViewModel
@{
    ViewData["Title"] = "Thẻ thư viện & Sách đang mượn";
}

<section class="portal-section">
    <div class="portal-container">
        <div class="portal-section__head">
            <div>
                <p class="portal-kicker">Không gian bạn đọc</p>
                <h1>Thẻ thư viện của tôi (@Model.CardNo)</h1>
                <p class="portal-section__description">@Model.FullName · @Model.ReaderTypeName (Tối đa @Model.MaxBorrowBooks cuốn / @Model.LoanDays ngày) · Hạn thẻ: @Model.CardExpiryDate.ToString(AppConstants.DefaultDateFormat)</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-quiet" href="@Screens.GetPath(ScreenId.ReaderBorrowHistory)">Lịch sử mượn</a>
                <a class="btn btn-quiet" href="@Screens.GetPath(ScreenId.ReaderFines)">Tiền phạt</a>
                <a class="btn btn-quiet" href="@Screens.GetPath(ScreenId.ReaderReservations)">Sách đặt trước</a>
            </div>
        </div>

        <h2 class="h5 mb-3">Sách đang mượn (@Model.ActiveLoans.Count / @Model.MaxBorrowBooks cuốn)</h2>
        @if (Model.ActiveLoans.Count == 0)
        {
            <div class="library-empty">
                <h3>Bạn chưa có sách đang mượn</h3>
                <p>Tra cứu danh mục tài liệu để tìm sách cần mượn tại thư viện.</p>
                <a href="@Screens.GetPath(ScreenId.BookCatalog)">Tra cứu sách</a>
            </div>
        }
        else
        {
            <div class="table-frame">
                <table class="table data-table">
                    <thead>
                        <tr>
                            <th>Mã phiếu / Barcode</th>
                            <th>Tên sách</th>
                            <th>Ngày mượn</th>
                            <th>Hạn trả</th>
                            <th class="num">Gia hạn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ActiveLoans)
                        {
                            <tr>
                                <td class="num">@item.SlipNo · @item.Barcode</td>
                                <td>
                                    <div class="fw-medium">@item.BookTitle</div>
                                    <div class="fs-xs text-muted-ink">@item.Authors</div>
                                </td>
                                <td class="num">@item.BorrowedAt.ToString(AppConstants.DefaultDateFormat)</td>
                                <td class="num">@item.DueDate.ToString(AppConstants.DefaultDateFormat)</td>
                                <td class="num">@item.RenewCount / @item.MaxRenewals</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

