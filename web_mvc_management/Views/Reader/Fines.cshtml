@model web_mvc_management.Models.ViewModels.Reader.ReaderPortalPageViewModel
@{
    ViewData["Title"] = "Tiền phạt của tôi";
}

<section class="portal-section">
    <div class="portal-container">
        <div class="portal-section__head">
            <div>
                <p class="portal-kicker">Không gian bạn đọc</p>
                <h1>Khoản phạt thư viện</h1>
                <p class="portal-section__description">Tổng tiền phạt chưa thanh toán: <strong class="num">@CurrencyHelper.ToVnd(Model.TotalUnpaidFine)</strong></p>
            </div>
            <a class="btn btn-quiet" href="@Screens.GetPath(ScreenId.ReaderProfile)">Về thẻ thư viện</a>
        </div>

        <div class="table-frame">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Tài liệu</th>
                        <th>Loại phạt</th>
                        <th class="num">Số tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Fines.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted-ink">Bạn không có khoản phạt nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var fine in Model.Fines)
                        {
                            <tr>
                                <td class="num">@fine.SlipNo</td>
                                <td>@fine.BookTitle</td>
                                <td>@fine.FineType</td>
                                <td class="num fw-medium">@CurrencyHelper.ToVnd(fine.Amount)</td>
                                <td><partial name="_StatusBadge" model="new StatusBadge(StatusKind.Fine, fine.FineStatus)" /></td>
                                <td class="num">@fine.CreatedAt.ToString(AppConstants.DefaultDateFormat)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

