@model web_mvc_management.Models.ViewModels.Reader.ReaderPortalPageViewModel
@using web_mvc_management.Constant
@{
    ViewData["Title"] = "Lịch sử mượn trả";
    ViewData["ScreenId"] = ScreenId.ReaderBorrowHistory;
    var currentLoanState = Model.HistoryFilter.LoanState ?? string.Empty;
}

<div class="reader-portal">
    @await Html.PartialAsync("_ReaderPortalHeader", Model)

    <section class="reader-section-card" aria-labelledby="borrow-history-heading">
        <div class="reader-section-card__header">
            <div>
                <h2 id="borrow-history-heading" class="reader-section-card__title">Nhật ký mượn trả tài liệu</h2>
                <p class="reader-section-card__subtitle">
                    Tra cứu toàn bộ các lượt mượn sách đang lưu hành và đã hoàn trả theo thẻ bạn đọc của bạn.
                </p>
            </div>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Reader" asp-action="Profile">
                <i class="bi bi-journal-bookmark me-1" aria-hidden="true"></i>Sách đang mượn (@Model.ActiveLoanCount)
            </a>
        </div>

        <form id="borrowHistoryFilterForm"
              asp-controller="Reader"
              asp-action="BorrowHistory"
              method="get"
              class="reader-filter-bar"
              role="search"
              aria-label="Bộ lọc lịch sử mượn trả">
            <input type="hidden" name="LoanState" id="historyLoanStateInput" value="@currentLoanState" />

            <div class="reader-filter-pills" role="group" aria-label="Lọc theo trạng thái mượn trả">
                <button type="button"
                        class="reader-filter-pill @(string.IsNullOrEmpty(currentLoanState) ? "reader-filter-pill--active" : "")"
                        data-loan-state="">
                    Tất cả (@Model.TotalHistoryCount)
                </button>
                <button type="button"
                        class="reader-filter-pill @(currentLoanState == "BORROWING" ? "reader-filter-pill--active" : "")"
                        data-loan-state="BORROWING">
                    Đang mượn (@Model.ActiveLoanCount)
                </button>
                <button type="button"
                        class="reader-filter-pill @(currentLoanState == "OVERDUE" ? "reader-filter-pill--active" : "")"
                        data-loan-state="OVERDUE">
                    Quá hạn (@Model.OverdueLoanCount)
                </button>
                <button type="button"
                        class="reader-filter-pill @(currentLoanState == "RETURNED" ? "reader-filter-pill--active" : "")"
                        data-loan-state="RETURNED">
                    Đã trả (@Model.ReturnedLoanCount)
                </button>
            </div>

            <div class="reader-filter-controls">
                <div class="input-group input-group-sm" style="min-width: 260px;">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted" aria-hidden="true"></i>
                    </span>
                    <input type="search"
                           name="Keyword"
                           id="historyKeywordInput"
                           value="@Model.HistoryFilter.Keyword"
                           class="form-control border-start-0"
                           placeholder="Tìm tên sách, mã phiếu, barcode..." />
                    <button type="submit" class="btn btn-primary">Lọc</button>
                </div>
            </div>
        </form>

        <div id="borrowHistoryTableContainer" aria-live="polite">
            @await Html.PartialAsync("_BorrowHistoryTable", Model)
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(function () {
            var $form = $('#borrowHistoryFilterForm');
            var $container = $('#borrowHistoryTableContainer');
            var $stateInput = $('#historyLoanStateInput');
            var $keywordInput = $('#historyKeywordInput');
            var debounceTimer = null;

            function loadBorrowHistory(url) {
                $container.css('opacity', '0.55');
                $.ajax({
                    url: url,
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                }).done(function (html) {
                    $container.html(html);
                    if (window.history && window.history.replaceState) {
                        window.history.replaceState(null, '', url);
                    }
                }).always(function () {
                    $container.css('opacity', '1');
                });
            }

            function submitFilterForm() {
                var query = $form.serialize();
                var baseUrl = $form.attr('action');
                var fullUrl = query ? (baseUrl + '?' + query) : baseUrl;
                loadBorrowHistory(fullUrl);
            }

            $form.on('click', '[data-loan-state]', function () {
                var state = $(this).attr('data-loan-state') || '';
                $stateInput.val(state);
                $form.find('[data-loan-state]').removeClass('reader-filter-pill--active');
                $(this).addClass('reader-filter-pill--active');
                submitFilterForm();
            });

            $form.on('submit', function (e) {
                e.preventDefault();
                submitFilterForm();
            });

            $keywordInput.on('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    submitFilterForm();
                }, 320);
            });

            $container.on('click', '.pagination a.page-link', function (e) {
                var href = $(this).attr('href');
                if (!href || $(this).closest('.page-item').hasClass('disabled')) {
                    return;
                }
                e.preventDefault();
                loadBorrowHistory(href);
            });

            $container.on('change', '[data-pager-size]', function (e) {
                var targetUrl = $(this).val();
                if (!targetUrl) {
                    return;
                }
                e.stopImmediatePropagation();
                loadBorrowHistory(targetUrl);
            });
        });
    </script>
}
