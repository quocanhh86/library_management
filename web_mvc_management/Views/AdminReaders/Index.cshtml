@model web_mvc_management.Models.ViewModels.SystemAdmin.AdminReadersPageViewModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Quản lý tài khoản & thẻ độc giả";
    ViewData["Screen"] = ScreenId.ManageReaders;
}

<div class="staff-page-head">
    <div>
        <h1>Quản lý tài khoản & thẻ độc giả</h1>
        <p class="text-muted-ink mb-0">Phân loại đối tượng bạn đọc, gia hạn thẻ và quản lý trạng thái khóa/mở khóa thẻ thư viện.</p>
    </div>
    <div class="staff-page-head__keys">
        <span class="shortcut-hint"><kbd>F2</kbd> Ô tìm mã thẻ</span>
    </div>
</div>

<form method="get" action="@Screens.GetPath(ScreenId.ManageReaders)" class="panel mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label d-flex justify-content-between" for="readerKeyword">
                <span>Mã thẻ / Họ tên / Email / Mã SV-GV</span>
                <kbd>F2</kbd>
            </label>
            <input type="search" class="form-control" id="readerKeyword" name="Keyword" value="@Model.Filter.Keyword" data-shortcut-focus="F2" data-search-input placeholder="Nhập mã thẻ SV2026..., họ tên hoặc email..." />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="readerTypeFilter">Loại độc giả</label>
            <select class="form-select" id="readerTypeFilter" name="ReaderTypeId">
                <option value="">Tất cả đối tượng</option>
                @foreach (var rt in Model.ReaderTypes)
                {
                    <option value="@rt.Id" selected="@(Model.Filter.ReaderTypeId == rt.Id)">@rt.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="readerCardStatus">Trạng thái thẻ</label>
            <select class="form-select" id="readerCardStatus" name="CardStatus">
                <option value="">Tất cả</option>
                <option value="@LibraryConstants.CardStatus.Active" selected="@(Model.Filter.CardStatus == LibraryConstants.CardStatus.Active)">Còn hạn (ACTIVE)</option>
                <option value="@LibraryConstants.CardStatus.Locked" selected="@(Model.Filter.CardStatus == LibraryConstants.CardStatus.Locked)">Bị khóa (LOCKED)</option>
                <option value="@LibraryConstants.CardStatus.Expired" selected="@(Model.Filter.CardStatus == LibraryConstants.CardStatus.Expired)">Hết hạn (EXPIRED)</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="readerRecordStatus">Trạng thái bản ghi</label>
            <div class="d-flex gap-2">
                <select class="form-select" id="readerRecordStatus" name="Status">
                    <option value="">Đang dùng (Mặc định)</option>
                    <option value="@EntityStatus.Active" selected="@(Model.Filter.Status == EntityStatus.Active)">Hoạt động (ACTIVE)</option>
                    <option value="@EntityStatus.Inactive" selected="@(Model.Filter.Status == EntityStatus.Inactive)">Vô hiệu hóa (INACTIVE)</option>
                    <option value="@EntityStatus.Deleted" selected="@(Model.Filter.Status == EntityStatus.Deleted)">Đã xóa mềm (DELETED)</option>
                </select>
                <button type="submit" class="btn btn-primary">Lọc</button>
            </div>
        </div>
    </div>
</form>

<div class="table-frame mb-2">
    <table class="table table-hover data-table">
        <thead>
            <tr>
                <th scope="col">Mã thẻ</th>
                <th scope="col">Độc giả / Email</th>
                <th scope="col">Loại độc giả (Định mức)</th>
                <th scope="col" class="num">Đang mượn</th>
                <th scope="col" class="num">Hạn thẻ</th>
                <th scope="col">Trạng thái thẻ</th>
                <th scope="col" class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PagedReaders.Items.Count == 0)
            {
                <tr>
                    <td colspan="7">
                        <div class="state-block text-center">
                            <div class="state-block__title">Không tìm thấy hồ sơ độc giả phù hợp</div>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var r in Model.PagedReaders.Items)
                {
                    <tr>
                        <td class="num fw-medium" style="text-align:left">
                            @r.CardNo
                            @if (!string.IsNullOrWhiteSpace(r.MemberCode))
                            {
                                <div class="fs-xs text-muted-ink">Mã: @r.MemberCode</div>
                            }
                        </td>
                        <td>
                            <div class="fw-medium">@r.FullName</div>
                            <div class="fs-xs text-muted-ink">@r.Email · @(r.Phone ?? "—")</div>
                        </td>
                        <td>
                            <div>@r.ReaderTypeName</div>
                            <div class="fs-xs text-muted-ink num">Tối đa @r.MaxBorrowBooks cuốn / @r.LoanDays ngày</div>
                        </td>
                        <td class="num">@r.ActiveBorrowCount / @r.MaxBorrowBooks cuốn</td>
                        <td class="num">@r.CardExpiryDate.ToString(AppConstants.DefaultDateFormat)</td>
                        <td>
                            <partial name="_StatusBadge" model="new StatusBadge(StatusKind.Card, r.CardStatus)" />
                            @if (r.Status == EntityStatus.Deleted)
                            {
                                <div class="mt-1"><span class="status status--danger">Đã xóa mềm (DELETED)</span></div>
                            }
                            else if (r.Status == EntityStatus.Inactive)
                            {
                                <div class="mt-1"><span class="status status--neutral">Vô hiệu hóa</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.LockReason))
                            {
                                <div class="fs-xs text-danger mt-1">@r.LockReason</div>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                @if (r.Status == EntityStatus.Deleted)
                                {
                                    <form method="post" action="@Screens.GetPath(ScreenId.ManageReaders)/Restore/@r.Id" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-quiet btn-sm">Khôi phục</button>
                                    </form>
                                    <form method="post" action="@Screens.GetPath(ScreenId.ManageReaders)/HardDelete/@r.Id" class="d-inline"
                                          data-hard-delete="Thẻ độc giả '@r.CardNo - @r.FullName'"
                                          data-hard-delete-detail="Chỉ xóa vĩnh viễn được khi độc giả chưa từng phát sinh phiếu mượn hoặc đặt trước sách.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">Xóa vĩnh viễn</button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-quiet btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#readerModal"
                                            data-id="@r.Id"
                                            data-card="@r.CardNo"
                                            data-name="@r.FullName"
                                            data-phone="@r.Phone"
                                            data-type="@r.ReaderTypeId"
                                            data-expiry="@r.CardExpiryDate.ToString("yyyy-MM-dd")"
                                            data-cardstatus="@r.CardStatus"
                                            data-reason="@r.LockReason"
                                            data-status="@r.Status">
                                        Quản lý thẻ
                                    </button>
                                    <form method="post" action="@Screens.GetPath(ScreenId.ManageReaders)/Delete/@r.Id" class="d-inline"
                                          data-confirm="Bước 1: Xóa mềm độc giả '@r.CardNo - @r.FullName'?"
                                          data-confirm-detail="Hồ sơ độc giả sẽ chuyển sang trạng thái DELETED (xóa mềm) và thu hồi phiên đăng nhập. Không thể xóa mềm nếu độc giả đang giữ sách chưa trả."
                                          data-confirm-ok="Xóa mềm (DELETED)"
                                          data-confirm-cancel="Giữ lại"
                                          data-confirm-danger>
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-quiet btn-sm text-danger">Xóa mềm</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model.PagedReaders" />

<div class="modal fade" id="readerModal" tabindex="-1" aria-labelledby="readerModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="@Screens.GetPath(ScreenId.ManageReaders)/Update">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="readerId" />
                <div class="modal-header">
                    <h2 class="modal-title" id="readerModalTitle">Quản lý thẻ <span class="num" id="readerCardLabel"></span></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label" for="readerFullName">Họ và tên độc giả</label>
                            <input type="text" class="form-control" id="readerFullName" name="FullName" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="readerPhone">Số điện thoại</label>
                            <input type="text" class="form-control num" id="readerPhone" name="Phone" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="readerTypeSelect">Loại độc giả (Quy định hạn mức mượn)</label>
                        <select class="form-select" id="readerTypeSelect" name="ReaderTypeId" required>
                            @foreach (var rt in Model.ReaderTypes)
                            {
                                <option value="@rt.Id">@rt.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="readerExpiry">Ngày hết hạn thẻ</label>
                            <input type="date" class="form-control num" id="readerExpiry" name="CardExpiryDate" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="readerCardStatusSelect">Trạng thái thẻ</label>
                            <select class="form-select" id="readerCardStatusSelect" name="CardStatus">
                                <option value="@LibraryConstants.CardStatus.Active">Đang hoạt động (ACTIVE)</option>
                                <option value="@LibraryConstants.CardStatus.Locked">Khóa thẻ (LOCKED)</option>
                                <option value="@LibraryConstants.CardStatus.Expired">Hết hạn (EXPIRED)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="readerLockReason">Lý do khóa thẻ (nếu chọn Khóa thẻ)</label>
                        <input type="text" class="form-control" id="readerLockReason" name="LockReason" placeholder="VD: Quá hạn trả sách nhiều lần, chưa nộp tiền phạt..." />
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="readerAccountStatus">Trạng thái tài khoản đăng nhập</label>
                        <select class="form-select" id="readerAccountStatus" name="Status">
                            <option value="@EntityStatus.Active">Cho phép đăng nhập (ACTIVE)</option>
                            <option value="@EntityStatus.Inactive">Vô hiệu hóa đăng nhập (INACTIVE)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('readerModal')?.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('readerId').value = btn.dataset.id || '';
            document.getElementById('readerCardLabel').textContent = btn.dataset.card || '';
            document.getElementById('readerFullName').value = btn.dataset.name || '';
            document.getElementById('readerPhone').value = btn.dataset.phone || '';
            document.getElementById('readerTypeSelect').value = btn.dataset.type || '';
            document.getElementById('readerExpiry').value = btn.dataset.expiry || '';
            document.getElementById('readerCardStatusSelect').value = btn.dataset.cardstatus || 'ACTIVE';
            document.getElementById('readerLockReason').value = btn.dataset.reason || '';
            document.getElementById('readerAccountStatus').value = btn.dataset.status || 'ACTIVE';
        });
    </script>
}

