        <mxCell id="sm_c3_3" value="&lt;b&gt;Quản lý Phiếu mượn &amp;amp; Gia hạn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Circulation/History | SCR_CIRCULATION_HISTORY&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="730" y="350" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c3_4" value="&lt;b&gt;Quản lý Thu phạt &amp;amp; Miễn giảm nợ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Fines | SCR_MANAGE_FINES&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="405" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c3_5" value="&lt;b&gt;Quản lý Đặt trước &amp;amp; Giữ sách&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Reservations | SCR_MANAGE_RESERVATIONS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="730" y="460" width="330" height="45" as="geometry" /></mxCell>

        <!-- Column 4 Items -->
        <mxCell id="sm_c4_1" value="&lt;b&gt;Bàn làm việc cán bộ (Dashboard)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/Dashboard | SCR_ADMIN_DASHBOARD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="240" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c4_2" value="&lt;b&gt;Quản lý Danh mục Đầu sách&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/Books | SCR_MANAGE_BOOKS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="295" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c4_3" value="&lt;b&gt;Quản lý Cuốn sách con &amp;amp; Mã vạch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/BookCopies | SCR_MANAGE_BOOK_COPIES&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="350" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c4_4" value="&lt;b&gt;Quản lý Thể loại sách&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/Categories | SCR_MANAGE_CATEGORIES&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="405" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c4_5" value="&lt;b&gt;Quản lý Tác giả &amp;amp; Nhà xuất bản&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/Authors &amp;amp; Publishers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="460" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c4_6" value="&lt;b&gt;Quản lý Kệ sách &amp;amp; Vị trí lưu kho&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/Shelves | SCR_MANAGE_SHELVES&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="515" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c4_7" value="&lt;b&gt;Quản lý Hồ sơ Độc giả (Thẻ thư viện)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/Readers | SCR_MANAGE_READERS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="570" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c4_8" value="&lt;b&gt;Cấu hình Nhóm &amp;amp; Loại độc giả&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/ReaderTypes | SCR_MANAGE_READER_TYPES&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="625" width="330" height="45" as="geometry" /></mxCell>

