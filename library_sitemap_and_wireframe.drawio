        <mxCell id="wf2_r2_txt" value="&lt;table width=&quot;100%&quot; style=&quot;font-size: 12px;&quot;&gt;&lt;tr&gt;&lt;td width=&quot;4%&quot; align=&quot;center&quot;&gt;&lt;input type=&quot;checkbox&quot; checked&gt;&lt;/td&gt;&lt;td width=&quot;28%&quot;&gt;&lt;b&gt;Lập trình C# .NET 10 Toàn Tập&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: #64748b;&quot;&gt;Mã vạch: BC-100234 | Giá bìa: 120.000 ₫&lt;/span&gt;&lt;/td&gt;&lt;td width=&quot;16%&quot;&gt;Hạn: 01/11/2026&lt;br&gt;&lt;span style=&quot;color: #dc2626; font-weight: bold;&quot;&gt;Quá hạn 3 ngày (+6.000 ₫)&lt;/span&gt;&lt;/td&gt;&lt;td width=&quot;20%&quot;&gt;&lt;div style=&quot;background: #fef2f2; border: 1px solid #ef4444; color: #b91c1c; font-weight: bold; padding: 4px 8px; border-radius: 4px; display: inline-block;&quot;&gt;Hỏng sách (Damaged) ▼&lt;/div&gt;&lt;br&gt;&lt;input type=&quot;text&quot; value=&quot;Rách 4 trang đầu, bung gáy&quot; style=&quot;margin-top: 4px; width: 220px; font-size: 11px;&quot;&gt;&lt;/td&gt;&lt;td width=&quot;20%&quot;&gt;&lt;span style=&quot;background: #d97706; color: white; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 11px;&quot;&gt;⚙ Thẩm định: 50% (60.000 ₫)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Thủ thư đã xác nhận mức độ hỏng vừa&lt;/span&gt;&lt;/td&gt;&lt;td width=&quot;12%&quot; align=&quot;right&quot;&gt;&lt;b style=&quot;color: #dc2626; font-size: 14px;&quot;&gt;66.000 ₫&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748b;&quot;&gt;(6k trễ + 60k hỏng)&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="1450" height="85" as="geometry" /></mxCell>

