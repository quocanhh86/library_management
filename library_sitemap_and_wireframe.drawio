  <diagram id="sitemap" name="1. Sitemap - Kiến trúc toàn hệ thống">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header Root -->
        <mxCell id="sm_root" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;HỆ THỐNG QUẢN LÝ THƯ VIỆN ĐẠI HỌC GIAO THÔNG VẬN TẢI (UTC LIBRARY SYSTEM)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; font-weight: normal;&quot;&gt;Kiến trúc Điều hướng Phân hệ &amp;amp; Danh mục Màn hình (ScreenConstants)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1b365d;strokeColor=#0f213a;fontColor=#ffffff;arcSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="635" y="30" width="580" height="70" as="geometry" />
        </mxCell>

        <!-- 5 Branches / Columns -->
        <!-- Branch 1: Public & Auth -->
        <mxCell id="sm_col1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;1. CỔNG KHÁCH &amp;amp; XÁC THỰC&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;(Public &amp;amp; Authentication)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#333333;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="300" height="55" as="geometry" />
