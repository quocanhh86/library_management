        <mxCell id="e_col1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="sm_root" target="sm_col1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Branch 2: Reader Portal -->
        <mxCell id="sm_col2" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;2. CỔNG DỊCH VỤ ĐỘC GIẢ&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;(Reader Portal - Role: Reader)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="150" width="310" height="55" as="geometry" />
