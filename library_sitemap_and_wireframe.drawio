        <mxCell id="wf2_pop_hdr" value="&lt;b style=&quot;font-size: 15px; color: #92400e;&quot;&gt;Thẩm định mức độ hư hại &amp;amp; Mức phạt thực tế&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#fcd34d;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="480" y="625" width="640" height="45" as="geometry" /></mxCell>
        <mxCell id="wf2_pop_body" value="&lt;p style=&quot;margin: 0; font-size: 13px;&quot;&gt;Cuốn sách: &lt;b&gt;Lập trình C# .NET 10 Toàn Tập (BC-100234)&lt;/b&gt;&lt;br&gt;Giá bìa gốc niêm yết: &lt;b style=&quot;color: #0369a1;&quot;&gt;120.000 ₫&lt;/b&gt;&lt;/p&gt;&lt;hr style=&quot;border: none; border-top: 1px dashed #cbd5e1; margin: 10px 0;&quot;&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;Thủ thư chọn mức độ hư hại theo tình trạng thực tế:&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top: 6px; line-height: 1.8; font-size: 12px;&quot;&gt;&lt;label&gt;&lt;input type=&quot;radio&quot; name=&quot;dmg&quot;&gt; &lt;b&gt;Hỏng nhẹ (20% giá bìa = 24.000 ₫)&lt;/b&gt; — Rách mép, bìa quăn nhẹ, tẩy sạch được&lt;/label&gt;&lt;br&gt;&lt;label&gt;&lt;input type=&quot;radio&quot; name=&quot;dmg&quot; checked&gt; &lt;b style=&quot;color: #b45309;&quot;&gt;Hỏng vừa (50% giá bìa = 60.000 ₫)&lt;/b&gt; — Rách dưới 5 trang, bẩn mực, bung gáy&lt;/label&gt;&lt;br&gt;&lt;label&gt;&lt;input type=&quot;radio&quot; name=&quot;dmg&quot;&gt; &lt;b style=&quot;color: #dc2626;&quot;&gt;Hỏng nặng (100% giá bìa = 120.000 ₫)&lt;/b&gt; — Mất nhiều trang, ướt nước hỏng hoàn toàn&lt;/label&gt;&lt;br&gt;&lt;label&gt;&lt;input type=&quot;radio&quot; name=&quot;dmg&quot;&gt; &lt;b&gt;Mất tài liệu (150% giá bìa = 180.000 ₫)&lt;/b&gt; — Đền bù mua mới &amp;amp; phí dán mã&lt;/label&gt;&lt;br&gt;&lt;label&gt;&lt;input type=&quot;radio&quot; name=&quot;dmg&quot;&gt; &lt;b&gt;Nhập số tiền khác:&lt;/b&gt; [&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;] ₫ (dành cho sách hiếm/không giá)&lt;/label&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 10px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Mô tả vết rách/hư hại:&lt;/b&gt;&lt;br&gt;&lt;input type=&quot;text&quot; value=&quot;Rách 4 trang đầu (trang 3-6), bung chỉ gáy giữa&quot; style=&quot;width: 580px; padding: 4px 8px; font-size: 12px; margin-top: 3px;&quot;&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="500" y="680" width="600" height="235" as="geometry" /></mxCell>
