        <mxCell id="wf3_head" value="&lt;h1 style=&quot;margin: 0; font-size: 24px;&quot;&gt;Cấu hình Quy định mượn trả &amp;amp; Mức phạt vi phạm&lt;/h1&gt;&lt;p style=&quot;margin: 4px 0 0 0; color: #64748b; font-size: 13px;&quot;&gt;Thiết lập mức phạt quá hạn, tỷ lệ đền bù sách hư hại/mất, trần nợ tối đa để khóa thẻ và định mức theo nhóm bạn đọc.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="950" height="60" as="geometry" /></mxCell>
        <mxCell id="wf3_key" value="&lt;span style=&quot;border: 1px solid #cbd5e1; background: #f8fafc; padding: 6px 12px; border-radius: 6px; font-size: 12px; color: #334155;&quot;&gt;Phím tắt: &lt;b&gt;[F9]&lt;/b&gt; Lưu quy định phạt&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="140" width="250" height="60" as="geometry" /></mxCell>

