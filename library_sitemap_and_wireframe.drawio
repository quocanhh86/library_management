        <mxCell id="wf3_lp_title" value="&lt;b style=&quot;font-size: 16px; color: #1e293b;&quot;&gt;1. Định mức phạt vi phạm &amp;amp; Giữ chỗ sách&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="95" y="235" width="450" height="35" as="geometry" /></mxCell>

        <!-- Field 1: Overdue fine -->
        <mxCell id="wf3_f1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Mức phạt trả quá hạn (theo ngày):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Áp dụng tự động cho mỗi cuốn sách trả trễ hạn trên từng ngày quá hạn.&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;&lt;input type=&quot;text&quot; value=&quot;2000&quot; style=&quot;width: 150px; font-size: 15px; font-weight: bold; text-align: right; padding: 6px 10px;&quot;&gt; &lt;b&gt;₫ / cuốn / ngày&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="95" y="280" width="650" height="75" as="geometry" /></mxCell>

        <!-- Field 2: Damaged percentage -->
        <mxCell id="wf3_f2" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Tỷ lệ phạt làm hỏng sách mặc định (gợi ý cho thủ thư):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Gợi ý tỷ lệ đền bù dựa trên giá bìa niêm yết của cuốn sách khi nhận trả.&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;&lt;input type=&quot;text&quot; value=&quot;50&quot; style=&quot;width: 150px; font-size: 15px; font-weight: bold; text-align: right; padding: 6px 10px;&quot;&gt; &lt;b&gt;% giá bìa sách&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="95" y="370" width="650" height="75" as="geometry" /></mxCell>

        <!-- Field 3: Lost percentage -->
        <mxCell id="wf3_f3" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Tỷ lệ đền bù làm mất sách:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Bao gồm 100% giá sách và 50% chi phí xử lý nghiệp vụ, dán mã vạch catalog.&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;&lt;input type=&quot;text&quot; value=&quot;150&quot; style=&quot;width: 150px; font-size: 15px; font-weight: bold; text-align: right; padding: 6px 10px;&quot;&gt; &lt;b&gt;% giá bìa sách&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="95" y="460" width="650" height="75" as="geometry" /></mxCell>

        <!-- Field 4: Max unpaid fine -->
        <mxCell id="wf3_f4" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Trần nợ phạt tối đa (Ngưỡng tự động khóa mượn sách):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Độc giả nợ phạt vượt quá mức này sẽ bị hệ thống tự động khóa quyền lập phiếu mượn mới.&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;&lt;input type=&quot;text&quot; value=&quot;50000&quot; style=&quot;width: 150px; font-size: 15px; font-weight: bold; text-align: right; padding: 6px 10px;&quot;&gt; &lt;b&gt;₫&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="95" y="550" width="650" height="75" as="geometry" /></mxCell>

        <!-- Field 5: Reservation hold hours -->
        <mxCell id="wf3_f5" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Thời gian giữ chỗ sách đặt trước:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Sau khi sách được giữ chỗ sẵn sàng, độc giả có ngần này giờ đến nhận trước khi tự động hủy.&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;&lt;input type=&quot;text&quot; value=&quot;48&quot; style=&quot;width: 150px; font-size: 15px; font-weight: bold; text-align: right; padding: 6px 10px;&quot;&gt; &lt;b&gt;Giờ (Hours)&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="95" y="640" width="650" height="75" as="geometry" /></mxCell>

