# ===========================================
# Environment Configuration (ASP.NET Core MVC)
# ===========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to source control!

# --- Application ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# --- Database (SQL Server) ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=library_management
DB_USER=sa
DB_PASSWORD=123456

# Connection string (SQL Server)
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=library_management;User Id=sa;Password=123456;TrustServerCertificate=True;

# --- Logging ---
LOGGING_LEVEL=Information

# --- Email / SMTP (Nhắc hạn trả sách, thông báo phạt) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
