# --- 1. Môi trường chạy ứng dụng (ASP.NET Core Host Configuration) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5024;https://localhost:5001
AllowedHosts=*

# --- 2. Cấu hình Database SQL Server (ConnectionStrings & DatabaseSettings) ---
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=library_management;User Id=sa;Password=your_db_password;TrustServerCertificate=True;"

# Cấu hình chi tiết từng thành phần theo Section DatabaseSettings:
DatabaseSettings__Host=localhost
DatabaseSettings__Port=1433
DatabaseSettings__Database=library_management
DatabaseSettings__Username=sa
DatabaseSettings__Password=your_db_password

# --- 3. Cấu hình Ghi Log (Logging__LogLevel) ---
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning

# --- 4. Cấu hình Email / SMTP (Section MailSettings -> Bind vào EmailSettings) ---
MailSettings__Host=smtp.gmail.com
MailSettings__Port=587
MailSettings__Username=your_email@gmail.com
MailSettings__Password=your_app_password
MailSettings__SenderDisplayName="Thư Viện UTC"
MailSettings__Protocol=smtp
MailSettings__Auth=true
MailSettings__StartTls=true
MailSettings__StartTlsRequired=true

# --- 5. Cấu hình Tài khoản Khởi tạo Mẫu (Section SeedSettings) ---
SeedSettings__DefaultPassword=your_seed_password

# Tài khoản 1 (Index 0)
SeedSettings__Users__0__Email=admin1@example.com
SeedSettings__Users__0__Role=Admin
SeedSettings__Users__0__Password=your_seed_password
SeedSettings__Users__0__FullName="Quản Trị Viên Mẫu 1"

# Tài khoản 2 (Index 1)
SeedSettings__Users__1__Email=admin2@example.com
SeedSettings__Users__1__Role=Admin
SeedSettings__Users__1__Password=your_seed_password
SeedSettings__Users__1__FullName="Quản Trị Viên Mẫu 2"

# Tài khoản 3 (Index 2)
SeedSettings__Users__2__Email=librarian@example.com
SeedSettings__Users__2__Role=Librarian
SeedSettings__Users__2__Password=your_seed_password
SeedSettings__Users__2__FullName="Cán Bộ Thủ Thư Mẫu"

# --- 6. Cấu hình Lưu trữ Ảnh Đám mây Cloudinary (Section CloudinarySettings) ---
# Điền CloudName, ApiKey, ApiSecret từ Cloudinary Dashboard (https://console.cloudinary.com).
# Nếu để trống hoặc giữ nguyên your_cloud_name, hệ thống tự động fallback lưu vào wwwroot/uploads/books/ để test local.
CloudinarySettings__CloudName=your_cloud_name
CloudinarySettings__ApiKey=your_api_key
CloudinarySettings__ApiSecret=your_api_secret
CloudinarySettings__Folder=library_management/books
