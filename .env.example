# ===========================================
# Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to source control!

# --- Application ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# --- Database ---
# DB_HOST=localhost
# DB_PORT=1433
# DB_NAME=app_management_db
# DB_USER=sa
# DB_PASSWORD=your_password_here

# Connection string (SQL Server)
# ConnectionStrings__DefaultConnection=Server=${DB_HOST},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;

# --- JWT Authentication ---
# JWT_SECRET_KEY=your-super-secret-key-at-least-32-characters
# JWT_ISSUER=app_management
# JWT_AUDIENCE=app_management_client
# JWT_EXPIRY_MINUTES=60

# --- Logging ---
LOGGING_LEVEL=Information

# --- CORS ---
# CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# --- Email / SMTP  ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# --- External APIs ---
# API_KEY=your_api_key_here

