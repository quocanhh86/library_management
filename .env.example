# --- 1. Môi trường chạy ứng dụng ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5024;https://localhost:5001

# --- 2. Cấu hình Database SQL Server ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=library_management
DB_USER=sa
DB_PASSWORD=123456

# Hoặc chuỗi kết nối trực tiếp (Ưu tiên cao nhất nếu được thiết lập):
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=library_management;User Id=sa;Password=123456;TrustServerCertificate=True;"

# --- 3. Ghi log ---
LOGGING_LEVEL=Information

# --- 4. Cấu hình Email / SMTP (Dùng khi nhắc hạn trả sách, thông báo phạt) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
