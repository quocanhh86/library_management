# --- 1. Môi trường chạy ứng dụng ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5024;https://localhost:5001

# --- 2. Cấu hình Database SQL Server ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=library_management
DB_USER=sa
DB_PASSWORD=123456

# Hoặc chuỗi kết nối trực tiếp (Ưu tiên cao nhất nếu được thiết lập):
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=library_management;User Id=sa;Password=123456;TrustServerCertificate=True;"

# --- 3. Ghi log ---
LOGGING_LEVEL=Information

# --- 4. Cấu hình Email / SMTP (Dùng khi xác thực 2FA OTP, nhắc hạn trả sách) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_SENDER_DISPLAY_NAME=Thư Viện UTC
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# Hoặc tiền tố chuẩn ASP.NET Core IConfiguration (tùy chọn):
# MailSettings__Host=smtp.gmail.com
# MailSettings__Port=587
# MailSettings__Username=your_email@gmail.com
# MailSettings__Password=your_app_password
# MailSettings__SenderDisplayName=Thư Viện UTC

# --- 5. Cấu hình Tài khoản Khởi tạo Mẫu (Seed Users & Roles) ---
DEFAULT_SEED_PASSWORD=123456

