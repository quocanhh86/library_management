        <mxCell id="wf01_brand" value="&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;div style=&quot;width: 36px; height: 36px; background: #eab308; border-radius: 50%; color: #1b1340; text-align: center; line-height: 36px; font-weight: bold; font-size: 13px;&quot;&gt;UTC&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding-left: 12px;&quot;&gt;&lt;b style=&quot;font-size: 14px; color: #1b1340;&quot;&gt;Thư viện UTC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #64748b;&quot;&gt;Trường Đại học Giao thông Vận tải&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="73" width="350" height="50" as="geometry" /></mxCell>
