      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sm_root" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;HỆ THỐNG QUẢN LÝ THƯ VIỆN ĐẠI HỌC GIAO THÔNG VẬN TẢI (UTC LIBRARY SYSTEM)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; font-weight: normal;&quot;&gt;Kiến trúc Điều hướng Phân hệ &amp;amp; Danh mục Màn hình (ScreenConstants)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1b1340;strokeColor=#0f0b24;fontColor=#ffffff;arcSize=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="635" y="30" width="580" height="70" as="geometry" /></mxCell>
        <mxCell id="sm_col1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;1. CỔNG KHÁCH &amp;amp; XÁC THỰC&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;(Public &amp;amp; Authentication)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#333333;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="e_col1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="sm_root" target="sm_col1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sm_col2" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;2. CỔNG DỊCH VỤ ĐỘC GIẢ&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;(Reader Portal - Role: Reader)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="310" height="55" as="geometry" /></mxCell>
        <mxCell id="e_col2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="sm_root" target="sm_col2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sm_col3" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;3. CỔNG LƯU THÔNG &amp;amp; THU PHẠT&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;(Circulation - Librarian &amp;amp; Admin)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#333333;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="150" width="330" height="55" as="geometry" /></mxCell>
        <mxCell id="e_col3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="sm_root" target="sm_col3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sm_col4" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;4. QUẢN TRỊ DANH MỤC &amp;amp; SÁCH&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;(Catalog - Librarian &amp;amp; Admin)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="330" height="55" as="geometry" /></mxCell>
        <mxCell id="e_col4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="sm_root" target="sm_col4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sm_col5" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;5. BÁO CÁO &amp;amp; CẤU HÌNH HỆ THỐNG&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;(System &amp;amp; Reports - Role: Admin)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#333333;fontStyle=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1470" y="150" width="310" height="55" as="geometry" /></mxCell>
        <mxCell id="e_col5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="sm_root" target="sm_col5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sm_c1_1" value="&lt;b&gt;Trang chủ cổng thông tin&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: / | SCR_HOME&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c1_2" value="&lt;b&gt;Đăng nhập Độc giả (Thẻ thư viện)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Account/Login | SCR_LOGIN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c1_3" value="&lt;b&gt;Đăng nhập Cán bộ / Thủ thư&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Account/StaffLogin | SCR_STAFF_LOGIN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c1_4" value="&lt;b&gt;Đăng ký thẻ bạn đọc mới&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Account/Register | SCR_REGISTER&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c1_5" value="&lt;b&gt;Xác thực mã bảo mật OTP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Account/VerifyOtp | SCR_VERIFY_OTP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c1_6" value="&lt;b&gt;Màn hình Từ chối truy cập (403)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Account/AccessDenied | SCR_ACCESS_DENIED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c2_1" value="&lt;b&gt;Tra cứu &amp;amp; Danh mục Sách mở&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Books | SCR_BOOK_CATALOG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="240" width="310" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c2_2" value="&lt;b&gt;Chi tiết Sách &amp;amp; Đặt trước (Hold)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Books/Detail/{id} | SCR_BOOK_DETAIL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="295" width="310" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c2_3" value="&lt;b&gt;Hồ sơ &amp;amp; Thẻ thư viện cá nhân&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Reader/Profile | SCR_READER_PROFILE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="380" y="350" width="310" height="45" as="geometry" /></mxCell>
