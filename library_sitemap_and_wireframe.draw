        <mxCell id="wf01_scopes" value="&lt;span style=&quot;background: #1b1340; color: white; padding: 7px 14px; border-radius: 4px; font-weight: bold; font-size: 12px;&quot;&gt;Tất cả tài liệu&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color: #64748b; font-size: 12px; padding: 7px 10px;&quot;&gt;Giáo trình&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color: #64748b; font-size: 12px; padding: 7px 10px;&quot;&gt;Luận văn &amp;amp; Đồ án&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color: #64748b; font-size: 12px; padding: 7px 10px;&quot;&gt;Tạp chí khoa học&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;a href=&quot;#&quot; style=&quot;color: #b45309; font-size: 12px; text-decoration: none; font-weight: 500;&quot;&gt;Tìm kiếm nâng cao ☵&lt;/a&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="380" width="880" height="30" as="geometry" /></mxCell>
