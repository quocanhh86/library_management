        <mxCell id="wf_01_home_bar" value="&amp;nbsp;🔴 🟡 🟢&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;https://thuvien.utc.edu.vn/&lt;/b&gt; — Trang chủ Cổng thông tin Thư viện UTC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#cccccc;align=left;spacingLeft=15;fontColor=#495057;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1520" height="35" as="geometry" /></mxCell>
