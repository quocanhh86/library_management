        <mxCell id="sm_c4_1" value="&lt;b&gt;Bàn làm việc cán bộ (Dashboard)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/Dashboard | SCR_ADMIN_DASHBOARD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="240" width="330" height="45" as="geometry" /></mxCell>
