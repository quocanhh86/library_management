        <mxCell id="sm_c4_3" value="&lt;b&gt;Quản lý Cuốn sách con &amp;amp; Mã vạch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/BookCopies | SCR_MANAGE_BOOK_COPIES&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="350" width="330" height="45" as="geometry" /></mxCell>
        <mxCell id="sm_c4_4" value="&lt;b&gt;Quản lý Thể loại sách&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 10px;&quot;&gt;Route: /Admin/Categories | SCR_MANAGE_CATEGORIES&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="405" width="330" height="45" as="geometry" /></mxCell>
